<file path="js/mural.js">
/* ==========================================================
   Mural de Oportunidades — lógica de filtros
   Implementa os critérios de aceitação da Etapa 1.
   ========================================================== */

const $ = (sel) => document.querySelector(sel);
const brl = new Intl.NumberFormat("pt-BR", { style: "currency", currency: "BRL", maximumFractionDigits: 0 });
const CARGA_MAX = 40;

const form = $("#form-filtros");
const el = {
  busca: $("#busca"),
  carga: $("#carga"),
  cargaValor: $("#carga-valor"),
  remuneracao: $("#remuneracao"),
  grupoRegiao: $("#grupo-regiao"),
  regiaoDica: $("#regiao-dica"),
  ordenar: $("#ordenar"),
  grade: $("#grade"),
  vazio: $("#vazio"),
  contagem: $("#contagem"),
  ativos: $("#filtros-ativos"),
  ativosVazio: $("#filtros-ativos-vazio"),
  qtdFiltros: $("#qtd-filtros"),
  painel: $("#painel-filtros"),
  detalhes: $("#detalhes"),
};

/* ---------- Favoritos e candidaturas (só nesta sessão) ---------- */
const favoritos = new Set(lerArmazenado("radar:favoritos"));
const iniciadas = new Set(lerArmazenado("radar:candidaturas"));   // candidaturas feitas pelo mural
const candidaturas = vagasInscritas();

// Vagas em que o estudante já está inscrito: as do mural + as de "Minhas candidaturas" (exceto retiradas).
function vagasInscritas() {
  const minhas = Radar.ler("radar:minhas", null) || CANDIDATURAS_ESTUDANTE;
  const s = new Set([...iniciadas, ...Object.keys(VINCULADAS_AGENDA).map(Number)]);
  minhas.forEach((c) => (c.situacao === "retirada" ? s.delete(c.vaga) : s.add(c.vaga)));
  iniciadas.forEach((v) => s.add(v));
  return s;
}

function lerArmazenado(chave) {
  return Radar.ler(chave, []);
}
function salvarArmazenado(chave, conjunto) {
  Radar.salvar(chave, [...conjunto]);
}

/* ---------- Montagem dos controles ---------- */
function chip(name, value, texto) {
  return `<label class="chip"><input type="checkbox" name="${name}" value="${value}"><span>${texto}</span></label>`;
}
$("#opcoes-area").innerHTML = AREAS.map((a) => chip("area", a, a)).join("");
$("#opcoes-tipo").innerHTML = Object.entries(TIPOS).map(([id, t]) => chip("tipo", id, t.nome)).join("");
$("#opcoes-dias").innerHTML = DIAS.map((d) => chip("dia", d.id, d.nome)).join("");
$("#opcoes-regiao").innerHTML = REGIOES.map(
  (r) => `<label><input type="checkbox" name="regiao" value="${r}"> ${r}</label>`
).join("");

/* ---------- Leitura do estado dos filtros ---------- */
function marcados(name) {
  return [...form.querySelectorAll(`input[name="${name}"]:checked`)].map((i) => i.value);
}

function lerFiltros() {
  const modalidade = form.querySelector('input[name="modalidade"]:checked').value;
  return {
    busca: el.busca.value.trim().toLowerCase(),
    areas: marcados("area"),
    tipos: marcados("tipo"),
    cargaMax: Number(el.carga.value),
    dias: marcados("dia"),
    modalidade,
    // Critério: com modalidade remota, o filtro de região é desconsiderado.
    regioes: modalidade === "remota" ? [] : marcados("regiao"),
    remMin: Number(el.remuneracao.value) || 0,
  };
}

/* ---------- Regras de filtragem (critérios de aceitação) ---------- */
function atende(v, f) {
  // Fluxo principal, passo 2: só oportunidades com inscrições abertas.
  if (v.status !== "aberta") return false;

  if (f.busca) {
    const texto = `${v.titulo} ${OFERTANTES[v.ofertante].nome} ${v.area}`.toLowerCase();
    if (!texto.includes(f.busca)) return false;
  }

  // Área de atuação corresponde à selecionada.
  if (f.areas.length && !f.areas.includes(v.area)) return false;

  if (f.tipos.length && !f.tipos.includes(v.tipo)) return false;

  // Carga horária semanal menor ou igual à informada.
  if (v.cargaHoraria > f.cargaMax) return false;

  // Todos os dias de trabalho estão entre os dias selecionados.
  if (f.dias.length && !v.dias.every((d) => f.dias.includes(d))) return false;

  // Modalidade igual à selecionada ("qualquer" aceita ambas).
  if (f.modalidade !== "qualquer" && v.modalidade !== f.modalidade) return false;

  // Vagas presenciais: localização em uma das regiões (nenhuma = qualquer região).
  if (v.modalidade === "presencial" && f.regioes.length && !f.regioes.includes(v.regiao)) return false;

  // Remuneração maior ou igual ao mínimo informado.
  if (v.remuneracao < f.remMin) return false;

  return true;
}

const ORDENACOES = {
  recentes: (a, b) => a.publicadaHaDias - b.publicadaHaDias,
  prazo: (a, b) => a.prazoDias - b.prazoDias,
  remuneracao: (a, b) => b.remuneracao - a.remuneracao,
  carga: (a, b) => a.cargaHoraria - b.cargaHoraria,
};

/* ---------- Filtros ativos (pílulas removíveis) ---------- */
function filtrosAtivos(f) {
  const lista = [];
  const desmarcar = (name, value) => () => {
    const input = form.querySelector(`input[name="${name}"][value="${value}"]`);
    if (input) input.checked = false;
  };
  if (f.busca) lista.push({ texto: `“${el.busca.value.trim()}”`, remover: () => (el.busca.value = "") });
  f.areas.forEach((a) => lista.push({ texto: a, remover: desmarcar("area", a) }));
  f.tipos.forEach((t) => lista.push({ texto: TIPOS[t].nome, remover: desmarcar("tipo", t) }));
  if (f.cargaMax < CARGA_MAX) lista.push({ texto: `Até ${f.cargaMax}h/semana`, remover: () => (el.carga.value = CARGA_MAX) });
  if (f.dias.length) {
    const nomes = DIAS.filter((d) => f.dias.includes(d.id)).map((d) => d.nome).join(", ");
    lista.push({ texto: `Dias: ${nomes}`, remover: () => form.querySelectorAll('input[name="dia"]').forEach((i) => (i.checked = false)) });
  }
  if (f.modalidade !== "qualquer") {
    lista.push({
      texto: f.modalidade === "remota" ? "Remota" : "Presencial",
      remover: () => (form.querySelector('input[name="modalidade"][value="qualquer"]').checked = true),
    });
  }
  f.regioes.forEach((r) => lista.push({ texto: r, remover: desmarcar("regiao", r) }));
  if (f.remMin) lista.push({ texto: `A partir de ${brl.format(f.remMin)}`, remover: () => (el.remuneracao.value = "") });
  return lista;
}

function renderizarPilulas(container, lista) {
  container.innerHTML = "";
  lista.forEach((item) => {
    const p = document.createElement("span");
    p.className = "pilula";
    p.innerHTML = `${item.texto}<button type="button" aria-label="Remover filtro ${item.texto}"><i class="ti ti-x"></i></button>`;
    p.querySelector("button").addEventListener("click", () => { item.remover(); atualizar(); });
    container.appendChild(p);
  });
}

/* ---------- Cartões ---------- */
function iniciais(nome, sigla) {
  if (sigla) return sigla;
  return nome.split(" ").filter((p) => p.length > 2 || p === p.toUpperCase()).slice(0, 2).map((p) => p[0]).join("").toUpperCase();
}

function textoPrazo(dias) {
  if (dias <= 0) return "Encerra hoje";
  if (dias === 1) return "Encerra amanhã";
  return `Encerra em ${dias} dias`;
}

function dataPrazo(dias) {
  const d = new Date();
  d.setDate(d.getDate() + dias);
  return d.toLocaleDateString("pt-BR", { day: "2-digit", month: "2-digit", year: "numeric" });
}

function miniDias(dias) {
  return `<span class="dias-semana" aria-label="Dias: ${DIAS.filter((d) => dias.includes(d.id)).map((d) => d.nome).join(", ")}">${
    DIAS.map((d) => `<span class="${dias.includes(d.id) ? "on" : ""}" title="${d.nome}">${d.curto}</span>`).join("")
  }</span>`;
}

function textoLocal(v) {
  return v.modalidade === "remota" ? "Remota" : `Presencial · ${v.regiao}`;
}

function cartao(v) {
  const of = OFERTANTES[v.ofertante];
  const tipo = TIPOS[v.tipo];
  const fav = favoritos.has(v.id);
  const inscrito = candidaturas.has(v.id);
  return `
  <article class="cartao" data-id="${v.id}">
    <div class="cartao-topo">
      <div class="logo-ofertante" style="background:${of.cor}">${iniciais(of.nome, of.sigla)}</div>
      <div class="cartao-titulos">
        <h3>${v.titulo}</h3>
        <div class="ofertante">${of.nome} <i class="ti ti-rosette-discount-check" title="Ofertante verificado pela universidade"></i></div>
      </div>
      <button class="btn btn-texto btn-icone favorito ${fav ? "ativo" : ""}" data-acao="favoritar" aria-pressed="${fav}" aria-label="Favoritar">
        <i class="ti ${fav ? "ti-heart-filled" : "ti-heart"}" style="font-size:20px"></i>
      </button>
    </div>
    <div class="cartao-etiquetas">
      <span class="etiqueta ${v.tipo}"><i class="ti ${tipo.icone}"></i>${tipo.nome}</span>
      <span class="etiqueta" style="background:var(--superficie-2);color:var(--texto-2)">${v.area}</span>
      ${inscrito ? '<span class="etiqueta sucesso"><i class="ti ti-check"></i>Inscrito</span>' : ""}
    </div>
    <div class="cartao-info">
      <div><i class="ti ti-cash"></i><span class="valor">${brl.format(v.remuneracao)}</span>/mês</div>
      <div><i class="ti ti-clock"></i><span class="valor">${v.cargaHoraria}h</span>/semana</div>
      <div><i class="ti ${v.modalidade === "remota" ? "ti-world" : "ti-map-pin"}"></i>${textoLocal(v)}</div>
      <div><i class="ti ti-calendar-week"></i>${miniDias(v.dias)}</div>
    </div>
    <div class="cartao-rodape">
      <span class="prazo ${v.prazoDias <= 4 ? "urgente" : ""}"><i class="ti ti-hourglass"></i>${textoPrazo(v.prazoDias)}</span>
      <button class="btn" data-acao="detalhes">Ver detalhes <i class="ti ti-arrow-right"></i></button>
    </div>
  </article>`;
}

/* ---------- Atualização geral ---------- */
function atualizar() {
  const f = lerFiltros();

  // Critério: quando a modalidade é remota, o filtro de região não é exibido.
  el.grupoRegiao.hidden = f.modalidade === "remota";
  el.regiaoDica.textContent = f.regioes.length ? `${f.regioes.length} selecionada(s)` : "Qualquer";
  el.cargaValor.textContent = f.cargaMax >= CARGA_MAX ? "Qualquer" : `até ${f.cargaMax}h`;

  const resultado = OPORTUNIDADES.filter((v) => atende(v, f)).sort(ORDENACOES[el.ordenar.value]);
  const ativos = filtrosAtivos(f);

  el.contagem.innerHTML = resultado.length === 1
    ? "<strong>1</strong> oportunidade com inscrições abertas"
    : `<strong>${resultado.length}</strong> oportunidades com inscrições abertas`;
  el.qtdFiltros.textContent = ativos.length ? `(${ativos.length})` : "";

  renderizarPilulas(el.ativos, ativos);

  if (resultado.length) {
    el.grade.innerHTML = resultado.map(cartao).join("");
    el.grade.hidden = false;
    el.vazio.hidden = true;
  } else {
    // Critério: mensagem de "nenhuma oportunidade" + sugestão de remover filtros.
    el.grade.innerHTML = "";
    el.grade.hidden = true;
    el.vazio.hidden = false;
    renderizarPilulas(el.ativosVazio, ativos);
  }
}

function limparFiltros() {
  form.reset();
  el.busca.value = "";
  el.remuneracao.value = "";
  el.carga.value = CARGA_MAX;
  atualizar();
}

/* ---------- Modal de detalhes ---------- */
function abrirDetalhes(id) {
  const v = OPORTUNIDADES.find((o) => o.id === id);
  const of = OFERTANTES[v.ofertante];
  const tipo = TIPOS[v.tipo];
  const aberta = v.status === "aberta";
  const inscrito = candidaturas.has(v.id);

  el.detalhes.innerHTML = `
    <div class="det-cabecalho">
      <div class="logo-ofertante" style="background:${of.cor}">${iniciais(of.nome, of.sigla)}</div>
      <div>
        <span class="etiqueta ${v.tipo}" style="margin-bottom:6px"><i class="ti ${tipo.icone}"></i>${tipo.nome}${v.regime ? ` · ${v.regime}` : ""}</span>
        <h2 id="det-titulo">${v.titulo}</h2>
        <div class="ofertante">${of.nome} · ${of.tipo} <i class="ti ti-rosette-discount-check" title="Ofertante verificado pela universidade"></i></div>
      </div>
      <button class="btn btn-texto btn-icone det-fechar" data-acao="fechar" aria-label="Fechar"><i class="ti ti-x" style="font-size:20px"></i></button>
    </div>
    <div class="det-corpo">
      ${aberta ? "" : `<div class="etiqueta alerta" style="border-radius:var(--raio);padding:10px 12px;font-size:14px"><i class="ti ti-lock"></i>Inscrições encerradas: ${v.motivoEncerramento}</div>`}
      <div class="det-resumo">
        <div><small>Remuneração</small><strong>${brl.format(v.remuneracao)}/mês</strong></div>
        <div><small>Carga horária</small><strong>${v.cargaHoraria}h semanais</strong></div>
        <div><small>Dias de trabalho</small><strong>${DIAS.filter((d) => v.dias.includes(d.id)).map((d) => d.nome).join(", ")}</strong></div>
        <div><small>Modalidade</small><strong>${textoLocal(v)}</strong></div>
        <div><small>Local</small><strong>${v.local}</strong></div>
        <div><small>Vagas</small><strong>${v.vagas}</strong></div>
      </div>
      <section class="det-secao"><h3>Sobre a oportunidade</h3><p>${v.descricao}</p></section>
      <section class="det-secao"><h3>Requisitos</h3><ul>${v.requisitos.map((r) => `<li>${r}</li>`).join("")}</ul></section>
      <section class="det-secao"><h3>Benefícios</h3><ul>${v.beneficios.map((b) => `<li>${b}</li>`).join("")}</ul></section>
      <section class="det-secao"><h3>Documentos para a candidatura</h3>
        <ul class="det-docs">${v.documentos.map((d) => `<li><i class="ti ti-file-text"></i>${d}</li>`).join("")}</ul>
      </section>
    </div>
    <div class="det-rodape">
      <span class="prazo"><i class="ti ti-hourglass"></i>Inscrições até ${dataPrazo(v.prazoDias)}</span>
      <div style="display:flex;gap:8px">
        ${botaoConversa(v.id, inscrito)}
        ${!aberta ? "" : inscrito
          ? '<button class="btn" disabled><i class="ti ti-check"></i> Candidatura enviada</button>'
          : '<button class="btn btn-primario" data-acao="candidatar"><i class="ti ti-send"></i> Candidatar-se</button>'}
      </div>
    </div>`;

  el.detalhes.dataset.id = id;
  el.detalhes.showModal();
}

/* ---------- Eventos ---------- */
const toast = Radar.toast;
form.addEventListener("input", atualizar);
form.addEventListener("change", atualizar);
el.busca.addEventListener("input", atualizar);
el.ordenar.addEventListener("change", atualizar);
$("#limpar-filtros").addEventListener("click", limparFiltros);
$("#limpar-filtros-vazio").addEventListener("click", limparFiltros);

$("#abrir-filtros").addEventListener("click", (e) => {
  const aberto = el.painel.classList.toggle("aberto");
  e.currentTarget.setAttribute("aria-expanded", aberto);
});

el.grade.addEventListener("click", (e) => {
  const botao = e.target.closest("[data-acao]");
  if (!botao) return;
  const id = Number(botao.closest(".cartao").dataset.id);
  if (botao.dataset.acao === "favoritar") {
    favoritos.has(id) ? favoritos.delete(id) : favoritos.add(id);
    salvarArmazenado("radar:favoritos", favoritos);
    toast(favoritos.has(id) ? "Adicionada aos favoritos" : "Removida dos favoritos", "ti-heart");
    atualizar();
  } else if (botao.dataset.acao === "detalhes") {
    abrirDetalhes(id);
  }
});

el.detalhes.addEventListener("click", (e) => {
  if (e.target === el.detalhes) return el.detalhes.close(); // clique fora do conteúdo
  const botao = e.target.closest("[data-acao]");
  if (!botao) return;
  const id = Number(el.detalhes.dataset.id);
  if (botao.dataset.acao === "fechar") el.detalhes.close();
  if (botao.dataset.acao === "candidatar") {
    candidaturas.add(id);
    iniciadas.add(id);
    salvarArmazenado("radar:candidaturas", iniciadas);
    abrirDetalhes(id);
    atualizar();
    toast('Candidatura iniciada. Envie os documentos em <a href="candidaturas.html?c=m-' + id + '" style="color:#fff;text-decoration:underline">Minhas candidaturas</a>.', "ti-circle-check");
  }
  if (botao.dataset.acao === "mensagem") {
    const conversa = conversaDaVaga(id);
    if (conversa) location.href = `mensagens.html?conversa=${conversa}`;
  }
});

/* ---------- Conversa com o ofertante da vaga ----------
   Existe quando o estudante já foi pré-selecionado (agenda de entrevistas)
   ou, na demonstração, nas conversas de exemplo. Antes disso o botão fica
   desabilitado, com o motivo escrito ao lado. */
function conversaDaVaga(id) {
  const agendaEst = Radar.ler("radar:agenda", null);
  const ag = agendaEst ? agendaEst.find((x) => x.oportunidade === id) : (VINCULADAS_AGENDA[id] ? { id: VINCULADAS_AGENDA[id] } : null);
  if (ag) return `ag-${ag.id}`;
  return Radar.ambiente === "demo" ? { 14: "ex-agro", 8: "ex-ic" }[id] || null : null;
}

function botaoConversa(id, inscrito) {
  if (inscrito && conversaDaVaga(id)) {
    return '<button class="btn" data-acao="mensagem"><i class="ti ti-message-circle"></i> Falar com ofertante</button>';
  }
  const motivo = inscrito ? "Disponível após a pré-seleção" : "Disponível após se candidatar";
  return `<span class="conversa-bloqueada">
      <button class="btn" disabled aria-describedby="motivo-conversa"><i class="ti ti-message-circle"></i> Falar com ofertante</button>
      <small id="motivo-conversa">${motivo}</small>
    </span>`;
}

/* ---------- Filtros a partir do perfil do estudante ---------- */
let perfilAplicado = false;

function aplicarPerfil() {
  const p = Radar.ler("radar:perfil-estudante", null);
  if (!p) return;
  form.reset();
  el.busca.value = "";
  el.carga.value = Math.min(CARGA_MAX, p.horas);
  el.remuneracao.value = p.remMin || "";
  const marcar = (name, valores) => valores.forEach((v) => { const i = form.querySelector(`input[name="${name}"][value="${v}"]`); if (i) i.checked = true; });
  marcar("area", p.areas); marcar("tipo", p.tipos); marcar("dia", p.dias); marcar("regiao", p.regioes);
  form.querySelector(`input[name="modalidade"][value="${p.modalidade}"]`).checked = true;
  perfilAplicado = true;
  atualizar();
  renderAvisoPerfil();
}

function renderAvisoPerfil() {
  const p = Radar.ler("radar:perfil-estudante", null);
  const caixa = $("#aviso-perfil");
  if (!p) {
    caixa.innerHTML = `<div class="aviso-perfil"><i class="ti ti-user-circle"></i><span>Complete seu perfil para ver primeiro as vagas que cabem na sua rotina.</span><a class="btn" href="perfil.html?bemvindo">Completar perfil</a></div>`;
  } else if (perfilAplicado) {
    caixa.innerHTML = `<div class="aviso-perfil ativo"><i class="ti ti-user-check"></i><span>Mostrando vagas compatíveis com o seu perfil: ${p.horas}h semanais, ${p.areas.join(", ")}.</span><button class="btn" data-perfil="todas">Ver todas as vagas</button><a class="btn btn-texto" href="perfil.html">Editar perfil</a></div>`;
  } else {
    caixa.innerHTML = `<div class="aviso-perfil"><i class="ti ti-sparkles"></i><span>Quer ver só as vagas compatíveis com a sua disponibilidade?</span><button class="btn btn-primario" data-perfil="aplicar">Usar filtros do meu perfil</button></div>`;
  }
}

$("#aviso-perfil").addEventListener("click", (e) => {
  const b = e.target.closest("[data-perfil]");
  if (!b) return;
  if (b.dataset.perfil === "aplicar") { aplicarPerfil(); toast("Filtros do seu perfil aplicados.", "ti-user-check"); }
  else { perfilAplicado = false; limparFiltros(); renderAvisoPerfil(); }
});
// Qualquer mudança manual nos filtros deixa de ser "o perfil"
const sairDoPerfil = () => { if (perfilAplicado) { perfilAplicado = false; renderAvisoPerfil(); } };
form.addEventListener("input", sairDoPerfil);
document.addEventListener("click", (e) => { if (e.target.closest(".pilula button, #limpar-filtros, #limpar-filtros-vazio")) sairDoPerfil(); });

atualizar();
if (new URLSearchParams(location.search).has("usar-perfil")) {
  aplicarPerfil();
  history.replaceState(null, "", location.pathname);
} else {
  renderAvisoPerfil();
}
</file>

<file path="js/perfil.js">
/* ==========================================================
   Meu perfil — caso de uso "Fazer cadastro estudantil e profissional"
   Atributos da classe Estudante: matrícula, curso, semestre,
   áreas de interesse, disponibilidade (horas e dias) e PcD.
   O perfil vira os filtros do mural ("Usar filtros do meu perfil").
   ========================================================== */

const $ = (s) => document.querySelector(s);
const esc = (s) => String(s ?? "").replace(/[&<>"]/g, (c) => ({ "&": "&amp;", "<": "&lt;", ">": "&gt;", '"': "&quot;" }[c]));
const brl = new Intl.NumberFormat("pt-BR", { style: "currency", currency: "BRL", maximumFractionDigits: 0 });
const BEM_VINDO = new URLSearchParams(location.search).has("bemvindo");
const CURSOS = ["Ciência da Computação", "Engenharia de Computação", "Sistemas de Informação", "Engenharia Civil", "Engenharia de Produção",
  "Administração", "Jornalismo", "Publicidade e Propaganda", "Design Visual", "Estatística", "Nutrição", "Matemática"];

const PADRAO = {
  matricula: Radar.estudante().matricula, nome: Radar.estudante().nome, curso: Radar.estudante().curso || "Ciência da Computação", semestre: Radar.estudante().semestre || 5,
  // Escolhas de exemplo só na demonstração; uma conta nova começa sem nada marcado
  ...(Radar.ambiente === "demo"
    ? { areas: ["Computação"], tipos: ["estagio", "bolsa"], dias: ["seg", "ter", "qua", "qui", "sex"] }
    : { areas: [], tipos: [], dias: [] }),
  horas: 20,
  modalidade: "qualquer", regioes: [], remMin: "", pcd: false, acessibilidade: "", curriculo: null, avisos: true,
  aulas: null, // preenchida com a grade do portal (abaixo)
};

// Grade do semestre como viria do portal do aluno (simulado). A agenda de entrevistas
// usa esta grade para avisar quando um horário de entrevista conflita com uma aula.
const GRADE_PORTAL = [
  { dia: "seg", ini: "13:30", fim: "15:10", disciplina: "INF01124 — Estruturas de Dados" },
  { dia: "ter", ini: "10:30", fim: "12:10", disciplina: "INF01127 — Engenharia de Software" },
  { dia: "qua", ini: "13:30", fim: "15:10", disciplina: "INF01124 — Estruturas de Dados" },
  { dia: "qui", ini: "10:30", fim: "12:10", disciplina: "INF01127 — Engenharia de Software" },
];
// Na demonstração a grade já vem importada; numa conta de teste começa vazia (há o botão de importar).
PADRAO.aulas = Radar.ambiente === "demo" ? GRADE_PORTAL.map((a) => ({ ...a })) : [];

const salvo = Radar.ler("radar:perfil-estudante", null);
// Nome e cartão vêm sempre da conta logada (nunca de um perfil salvo antes)
let p = { ...PADRAO, ...(salvo || {}), nome: PADRAO.nome, matricula: PADRAO.matricula };
let original = JSON.stringify(p);
let erros = {};

/* ---------- Compatibilidade: mesma regra dos filtros do mural ---------- */
function compativeis() {
  return OPORTUNIDADES.filter((v) => {
    if (v.status !== "aberta") return false;
    if (p.areas.length && !p.areas.includes(v.area)) return false;
    if (p.tipos.length && !p.tipos.includes(v.tipo)) return false;
    if (v.cargaHoraria > p.horas) return false;
    if (p.dias.length && !v.dias.every((d) => p.dias.includes(d))) return false;
    if (p.modalidade !== "qualquer" && v.modalidade !== p.modalidade) return false;
    if (v.modalidade === "presencial" && p.modalidade !== "remota" && p.regioes.length && !p.regioes.includes(v.regiao)) return false;
    if (p.remMin && v.remuneracao < Number(p.remMin)) return false;
    return true;
  });
}

/* ---------- Renderização ---------- */
const chip = (name, value, texto, marcado) =>
  `<label class="chip"><input type="checkbox" name="${name}" value="${esc(value)}" ${marcado ? "checked" : ""}><span>${esc(texto)}</span></label>`;
const erro = (c) => erros[c] ? `<p class="erro-campo" id="erro-${c}"><i class="ti ti-alert-circle"></i>${erros[c]}</p>` : "";
const cls = (c) => `campo-form ${erros[c] ? "invalido" : ""}`;

function renderCabecalho() {
  $("#cabecalho").innerHTML = `
    <div>
      <h1>${BEM_VINDO ? "Complete seu perfil" : "Meu perfil"}</h1>
      ${BEM_VINDO ? "<p>Leva um minuto e ajuda o Radar a mostrar as vagas que cabem na sua rotina.</p>" : ""}
    </div>`;
}

function render() {
  const n = compativeis().length;
  const horasDia = p.dias.length ? p.horas / p.dias.length : 0;
  $("#form").innerHTML = `
    ${BEM_VINDO ? `<div class="boas-vindas"><i class="ti ti-confetti"></i><div><strong>Boas-vindas ao Radar, ${esc(p.nome.split(" ")[0])}!</strong></div></div>` : ""}

    <section class="secao-perfil">
      <h2><i class="ti ti-school"></i> Dados acadêmicos</h2>
      <div class="grade-campos">
        <div class="campo-form"><span class="rotulo">Nome</span><div class="campo-fixo"><i class="ti ti-lock"></i>${esc(p.nome)}</div></div>
        <div class="campo-form"><span class="rotulo">Cartão UFRGS</span><div class="campo-fixo"><i class="ti ti-lock"></i>${esc(p.matricula)}</div></div>
        <div class="${cls("curso")}">
          <label for="curso">Curso</label>
          <select id="curso" name="curso" ${erros.curso ? 'aria-invalid="true"' : ""}><option value="">Selecione</option>${CURSOS.map((c) => `<option ${c === p.curso ? "selected" : ""}>${c}</option>`).join("")}</select>
          ${erro("curso")}
        </div>
        <div class="${cls("semestre")}">
          <label for="semestre">Semestre atual</label>
          <input type="number" id="semestre" name="semestre" min="1" max="14" value="${p.semestre}" ${erros.semestre ? 'aria-invalid="true"' : ""}>
          ${erro("semestre")}
        </div>
      </div>
    </section>

    <section class="secao-perfil">
      <h2><i class="ti ti-target-arrow"></i> O que você procura</h2>
      <div class="grade-campos">
        <div class="${cls("areas")} cheio">
          <span class="rotulo">Áreas de interesse</span>
          <div class="chips" role="group" aria-label="Áreas de interesse">${AREAS.map((a) => chip("areas", a, a, p.areas.includes(a))).join("")}</div>
          ${erro("areas")}
        </div>
        <div class="${cls("tipos")} cheio">
          <span class="rotulo">Tipos de oportunidade</span>
          <div class="chips" role="group" aria-label="Tipos de oportunidade">${Object.entries(TIPOS).map(([id, t]) => chip("tipos", id, t.nome, p.tipos.includes(id))).join("")}</div>
          ${erro("tipos")}
        </div>
      </div>
    </section>

    <section class="secao-perfil">
      <h2><i class="ti ti-calendar-time"></i> Disponibilidade</h2>
      <div class="grade-campos">
        <div class="campo-form cheio">
          <label for="horas">Horas por semana disponíveis</label>
          <div class="faixa"><input type="range" id="horas" name="horas" min="4" max="40" step="2" value="${p.horas}"><output id="horas-valor">até ${p.horas}h</output></div>
          ${p.tipos.includes("estagio") && horasDia > 6 ? `<p class="ajuda">Estágios têm no máximo 6h por dia: com ${p.dias.length} ${p.dias.length === 1 ? "dia" : "dias"}, um estágio terá até ${6 * p.dias.length}h semanais.</p>` : ""}
        </div>
        <div class="${cls("dias")} cheio">
          <span class="rotulo">Dias disponíveis</span>
          <div class="chips dias" role="group" aria-label="Dias disponíveis">${DIAS.map((d) => chip("dias", d.id, d.nome, p.dias.includes(d.id))).join("")}</div>
          ${erro("dias")}
        </div>
        <div class="campo-form">
          <span class="rotulo">Modalidade preferida</span>
          <div class="segmentado" role="radiogroup" aria-label="Modalidade preferida">
            ${[["presencial", "Presencial"], ["remota", "Remota"], ["qualquer", "Qualquer"]].map(([v, t]) => `<label><input type="radio" name="modalidade" value="${v}" ${p.modalidade === v ? "checked" : ""}><span>${t}</span></label>`).join("")}
          </div>
        </div>
        <div class="campo-form">
          <label for="remMin">Remuneração mínima <span class="opcional">(opcional)</span></label>
          <div class="prefixo"><span>R$</span><input type="number" id="remMin" name="remMin" min="0" step="50" value="${p.remMin}" placeholder="0"></div>
        </div>
        ${p.modalidade !== "remota" ? `
        <div class="campo-form cheio">
          <span class="rotulo">Regiões de fácil acesso <span class="opcional">(opcional)</span></span>
          <div class="chips" role="group" aria-label="Regiões">${REGIOES.map((r) => chip("regioes", r, r, p.regioes.includes(r))).join("")}</div>
        </div>` : ""}
      </div>
    </section>

    <section class="secao-perfil" id="grade">
      <h2><i class="ti ti-calendar-week"></i> Grade de aulas</h2>
      <div class="aulas ${erros.aulas ? "invalido" : ""}">
        ${p.aulas.length ? `<div class="aula-cab"><span>Dia</span><span>Início</span><span>Fim</span><span>Disciplina</span><span></span></div>` : ""}
        ${p.aulas.map((a, i) => `
        <div class="aula-linha">
          <select data-aula="${i}" data-campo="dia" aria-label="Dia da aula ${i + 1}">${DIAS.map((d) => `<option value="${d.id}" ${d.id === a.dia ? "selected" : ""}>${d.nome}</option>`).join("")}</select>
          <input type="time" data-aula="${i}" data-campo="ini" value="${a.ini}" step="600" aria-label="Início da aula ${i + 1}">
          <input type="time" data-aula="${i}" data-campo="fim" value="${a.fim}" step="600" aria-label="Fim da aula ${i + 1}">
          <input type="text" data-aula="${i}" data-campo="disciplina" value="${esc(a.disciplina)}" placeholder="Disciplina" aria-label="Disciplina da aula ${i + 1}">
          <button type="button" class="btn btn-texto btn-icone" data-rem-aula="${i}" aria-label="Remover aula ${i + 1}"><i class="ti ti-trash"></i></button>
        </div>`).join("") || '<p class="ajuda">Nenhuma aula cadastrada.</p>'}
        ${erro("aulas")}
      </div>
      <div class="aulas-acoes">
        <button type="button" class="btn" data-add-aula><i class="ti ti-plus"></i> Adicionar aula</button>
        <button type="button" class="btn btn-texto" data-importar-grade><i class="ti ti-download"></i> Importar</button>
      </div>
    </section>

    <section class="secao-perfil">
      <h2><i class="ti ti-id"></i> Currículo e acessibilidade</h2>
      <div class="grade-campos">
        <div class="campo-form cheio">
          <div class="anexo-cv">
            <i class="ti ti-file-cv ic"></i>
            <div class="nome">${p.curriculo ? `<b>${esc(p.curriculo.nome)}</b><small>${esc(p.curriculo.tamanho)}</small>` : "Nenhum currículo enviado<small>PDF de até 5 MB</small>"}</div>
            <label><input type="file" id="curriculo" accept=".pdf" aria-label="Enviar currículo em PDF"><span class="btn"><i class="ti ti-upload"></i> ${p.curriculo ? "Trocar" : "Enviar"}</span></label>
          </div>
        </div>
        <div class="campo-form cheio">
          <label class="check-linha"><input type="checkbox" name="pcd" ${p.pcd ? "checked" : ""}> Sou pessoa com deficiência</label>
        </div>
        ${p.pcd ? `
        <div class="campo-form cheio">
          <label for="acessibilidade">Recursos de acessibilidade</label>
          <textarea id="acessibilidade" name="acessibilidade" placeholder="Intérprete de Libras na entrevista, leitor de tela, mesa adaptada…">${esc(p.acessibilidade)}</textarea>
        </div>` : ""}
        <div class="campo-form cheio">
          <label class="check-linha"><input type="checkbox" name="avisos" ${p.avisos ? "checked" : ""}> Avisar sobre vagas compatíveis</label>
        </div>
      </div>
    </section>

    <div class="barra-salvar">
      <span id="compat"><i class="ti ti-radar"></i> <b>${n}</b> ${n === 1 ? "vaga aberta combina" : "vagas abertas combinam"} com este perfil agora.</span>
      <div class="dir">
        ${BEM_VINDO ? '<a class="btn btn-texto" href="mural.html">Pular por enquanto</a>' : ""}
        <button type="submit" class="btn btn-primario"><i class="ti ti-device-floppy"></i> ${BEM_VINDO ? "Salvar e ver vagas" : "Salvar perfil"}</button>
      </div>
    </div>`;
}

/* ---------- Validação ---------- */
function validar() {
  const e = {};
  if (!p.curso) e.curso = "Selecione o seu curso.";
  if (!(p.semestre >= 1 && p.semestre <= 14)) e.semestre = "Informe um semestre entre 1 e 14.";
  if (!p.areas.length) e.areas = "Marque pelo menos uma área de interesse.";
  if (!p.tipos.length) e.tipos = "Marque pelo menos um tipo de oportunidade.";
  if (!p.dias.length) e.dias = "Marque pelo menos um dia disponível.";
  const ruim = p.aulas.findIndex((a) => !a.ini || !a.fim || a.fim <= a.ini);
  if (ruim >= 0) e.aulas = `Aula ${ruim + 1}: o horário de fim precisa ser depois do início.`;
  return e;
}

/* ---------- Eventos ---------- */
const MULTI = ["areas", "tipos", "dias", "regioes"];
$("#form").addEventListener("input", (e) => {
  const el = e.target;
  // Linhas da grade de aulas
  if (el.dataset.aula !== undefined) {
    p.aulas[Number(el.dataset.aula)][el.dataset.campo] = el.value;
    if (erros.aulas) { delete erros.aulas; document.querySelector(".aulas")?.classList.remove("invalido"); document.querySelector(".aulas .erro-campo")?.remove(); }
    return;
  }
  if (!el.name) return;
  if (MULTI.includes(el.name)) p[el.name] = [...document.querySelectorAll(`input[name="${el.name}"]:checked`)].map((i) => i.value);
  else if (el.type === "checkbox") p[el.name] = el.checked;
  else if (el.type === "number" || el.type === "range") p[el.name] = el.value === "" ? "" : Number(el.value);
  else p[el.name] = el.value;
  if (el.name === "horas") { $("#horas-valor").textContent = `até ${p.horas}h`; }
  delete erros[el.name];
  // Redesenha só quando a estrutura muda; nos demais casos atualiza a contagem
  if (["pcd", "modalidade", "tipos", "dias"].includes(el.name) || (el.name === "horas" && p.tipos.includes("estagio"))) {
    const foco = el.type === "radio" || el.type === "checkbox" ? `input[name="${el.name}"][value="${el.value}"]` : `#${el.id}`;
    render();
    document.querySelector(foco)?.focus();
  } else {
    const box = el.closest(".campo-form");
    box?.classList.remove("invalido"); box?.querySelector(".erro-campo")?.remove();
    const n = compativeis().length;
    $("#compat").innerHTML = `<i class="ti ti-radar"></i> <b>${n}</b> ${n === 1 ? "vaga aberta combina" : "vagas abertas combinam"} com este perfil agora.`;
  }
});

$("#form").addEventListener("click", (e) => {
  if (e.target.closest("[data-add-aula]")) {
    const ultima = p.aulas[p.aulas.length - 1];
    p.aulas.push({ dia: ultima ? ultima.dia : "seg", ini: "08:30", fim: "10:10", disciplina: "" });
    render();
    document.querySelector(`[data-aula="${p.aulas.length - 1}"][data-campo="dia"]`)?.focus();
  }
  const rem = e.target.closest("[data-rem-aula]");
  if (rem) {
    p.aulas.splice(Number(rem.dataset.remAula), 1);
    delete erros.aulas;
    render();
    document.querySelector("[data-add-aula]")?.focus();
  }
  if (e.target.closest("[data-importar-grade]")) {
    p.aulas = GRADE_PORTAL.map((a) => ({ ...a }));
    delete erros.aulas;
    render();
    Radar.toast("Grade importada do portal do aluno (simulado).", "ti-download");
  }
});

$("#form").addEventListener("change", (e) => {
  if (e.target.id !== "curriculo" || !e.target.files[0]) return;
  const f = e.target.files[0];
  if (f.type !== "application/pdf") return Radar.toast("Envie o currículo em PDF.", "ti-alert-circle");
  if (f.size > 5 * 1024 * 1024) return Radar.toast("O arquivo passa de 5 MB.", "ti-alert-circle");
  p.curriculo = { nome: f.name, tamanho: f.size > 1048576 ? `${(f.size / 1048576).toFixed(1)} MB` : `${Math.max(1, Math.round(f.size / 1024))} KB` };
  render();
  Radar.toast("Currículo anexado.", "ti-file-check");
});

$("#form").addEventListener("submit", (e) => {
  e.preventDefault();
  erros = validar();
  if (Object.keys(erros).length) {
    render();
    const aulaRuim = p.aulas.findIndex((a) => !a.ini || !a.fim || a.fim <= a.ini);
    const alvo = document.querySelector(".campo-form.invalido select, .campo-form.invalido input")
      || document.querySelector(`[data-aula="${aulaRuim}"][data-campo="fim"]`);
    alvo?.focus(); alvo?.scrollIntoView({ block: "center", behavior: "smooth" });
    return;
  }
  Radar.salvar("radar:perfil-estudante", p);
  original = JSON.stringify(p);
  if (BEM_VINDO) { location.href = "mural.html?usar-perfil"; return; }
  Radar.toast("Perfil atualizado.", "ti-circle-check");
});

window.addEventListener("beforeunload", (e) => { if (!BEM_VINDO && JSON.stringify(p) !== original) e.preventDefault(); });

renderCabecalho();
render();
</file>

<file path="agenda-ofertante.html">
<!DOCTYPE html>
<html lang="pt-BR">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Agenda de entrevistas · Radar UFRGS</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/@tabler/icons-webfont@2.47.0/tabler-icons.min.css">
  <link rel="stylesheet" href="css/style.css">
  <link rel="stylesheet" href="css/agenda.css">
  <link rel="stylesheet" href="css/ofertante.css">
</head>
<body>

  <!-- Barra superior: montada por js/comum.js -->
  <header class="topo" data-perfil="ofertante" data-pagina="agenda"></header>

  <section class="cabecalho-pagina">
    <h1>Agenda de entrevistas</h1>
    <p>Marque os horários em que você pode entrevistar os candidatos aprovados na pré-seleção.</p>
    <div class="vagas-abas" id="vagas-abas" role="tablist" aria-label="Vagas"></div>
  </section>

  <main class="of-layout">
    <div class="of-principal">
      <!-- Configuração da entrevista -->
      <section class="bloco config" aria-label="Configuração da entrevista">
        <div class="campo-linha">
          <label for="cfg-formato">Formato e local</label>
          <select id="cfg-formato"></select>
        </div>
        <div class="campo-linha">
          <label>Duração</label>
          <div class="valor-fixo"><i class="ti ti-clock"></i> 30 min</div>
        </div>
        <div class="campo-linha">
          <label for="cfg-prazo">Candidatos escolhem até</label>
          <input type="date" id="cfg-prazo">
        </div>
      </section>

      <!-- Editor da agenda -->
      <section class="bloco" aria-label="Horários disponíveis">
        <div class="agenda-topo">
          <div>
            <h3>Horários disponíveis</h3>
            <p class="prazo-escolha"><i class="ti ti-pointer"></i>Clique num horário para abrir ou fechar. Para marcar vários de uma vez, <b>segure o botão do mouse e passe por cima deles</b>. Clique num horário reservado para ver a entrevista.</p>
          </div>
          <div class="nav-semana">
            <button class="btn btn-icone" id="sem-ant" aria-label="Semana anterior"><i class="ti ti-chevron-left"></i></button>
            <span id="sem-rotulo"></span>
            <button class="btn btn-icone" id="sem-prox" aria-label="Próxima semana"><i class="ti ti-chevron-right"></i></button>
          </div>
        </div>

        <div class="metricas" id="metricas"></div>
        <div id="alerta-capacidade"></div>

        <div class="legenda">
          <span><span class="amostra vazio"></span>Fechado</span>
          <span><span class="amostra livre"></span>Aberto</span>
          <span><span class="amostra reservado"></span>Reservado</span>
          <span><span class="amostra add"></span>Será aberto</span>
          <span><span class="amostra rem"></span>Será fechado</span>
        </div>

        <div class="grade-wrap">
          <div class="grade-horarios" id="grade" role="grid" aria-label="Grade de horários da semana"></div>
        </div>
      </section>
    </div>

    <!-- Candidatos aprovados -->
    <aside class="bloco candidatos" aria-label="Candidatos aprovados">
      <div class="cand-topo">
        <h3>Candidatos aprovados</h3>
        <span class="etiqueta neutra" id="cand-qtd"></span>
      </div>
      <div id="lista-candidatos"></div>
    </aside>
  </main>

  <!-- Barra de publicação (aparece quando há mudanças) -->
  <div class="barra-publicar" id="barra-publicar" hidden>
    <div class="barra-publicar-interno">
      <span id="resumo-mudancas"></span>
      <div style="display:flex;gap:8px">
        <button class="btn" id="descartar">Descartar</button>
        <button class="btn btn-primario" id="publicar"><i class="ti ti-send"></i> <span id="publicar-rotulo">Publicar agenda</span></button>
      </div>
    </div>
  </div>

  <!-- Entrevista reservada -->
  <dialog class="modal" id="modal-reserva" aria-labelledby="mr-titulo">
    <div class="modal-corpo">
      <h2 id="mr-titulo">Entrevista marcada</h2>
      <div class="resumo-entrevista" id="mr-resumo"></div>
      <div class="campo" id="mr-cancelar" hidden>
        <label for="mr-motivo">Explique o cancelamento ao candidato</label>
        <textarea id="mr-motivo" placeholder="Tivemos um imprevisto na equipe e precisamos remarcar."></textarea>
        <p class="erro" id="mr-erro"></p>
        <p style="font-size:13px">O horário é retirado da agenda e o candidato é notificado para escolher outro.</p>
      </div>
    </div>
    <div class="modal-rodape" id="mr-rodape"></div>
  </dialog>

  <!-- Conversa com candidato -->
  <div class="fundo-gaveta" id="fundo-gaveta" hidden></div>
  <aside class="conversa" id="conversa" aria-label="Conversa com o candidato" aria-hidden="true">
    <div class="conversa-cab" id="conversa-cab"></div>
    <div class="mensagens" id="mensagens"></div>
    <div class="respostas-rapidas" id="respostas-rapidas"></div>
    <form class="conversa-form" id="conversa-form">
      <label class="sr-only" for="conversa-texto">Mensagem</label>
      <textarea id="conversa-texto" placeholder="Escreva uma mensagem"></textarea>
      <button class="btn btn-primario btn-icone" type="submit" aria-label="Enviar"><i class="ti ti-send" style="font-size:18px"></i></button>
    </form>
  </aside>

  <script src="js/comum.js"></script>
  <script src="js/dados.js"></script>
  <script src="js/agenda-dados.js"></script>
  <script src="js/ofertante-dados.js"></script>
  <script src="js/agenda-ofertante.js"></script>
</body>
</html>
