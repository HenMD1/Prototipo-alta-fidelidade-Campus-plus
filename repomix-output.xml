<file path="css/agenda.css">
/* ==========================================================
   Entrevistas — agendar entrevista com o ofertante
   ========================================================== */

.cabecalho-pagina {
  max-width: 1280px; margin: 0 auto; padding: 28px 24px 8px;
}
.cabecalho-pagina h1 { font-size: 26px; letter-spacing: -.02em; }
.cabecalho-pagina p { color: var(--texto-2); margin-top: 4px; }

.agenda-layout {
  max-width: 1280px; margin: 0 auto; padding: 16px 24px 96px;
  display: grid; grid-template-columns: 300px minmax(0, 1fr); gap: 24px; align-items: start;
}

/* ---------- Lista de candidaturas ---------- */
.lista-cand { position: sticky; top: 80px; display: flex; flex-direction: column; gap: 8px; }
.lista-cand h2 { font-size: 13px; text-transform: uppercase; letter-spacing: .06em; color: var(--texto-3); margin: 0 0 4px 4px; }
.item-cand {
  display: flex; gap: 12px; align-items: flex-start; text-align: left; width: 100%;
  padding: 14px; border-radius: var(--raio-lg);
  border: 1px solid var(--borda); background: var(--superficie); cursor: pointer;
  transition: border-color .15s, box-shadow .15s;
}
.item-cand:hover { border-color: var(--borda-forte); }
.item-cand.ativo { border-color: var(--cor-primaria); box-shadow: 0 0 0 3px var(--cor-primaria-clara); }
.item-cand .logo-ofertante { width: 40px; height: 40px; font-size: 13px; }
.item-cand-texto { min-width: 0; flex: 1; }
.item-cand-titulo { font-weight: 600; font-size: 14px; line-height: 1.3; }
.item-cand-of { font-size: 12px; color: var(--texto-3); margin: 2px 0 8px; }
.etiqueta.neutra { background: var(--superficie-2); color: var(--texto-2); }
.etiqueta.perigo { background: #fdecec; color: #9b2222; }

.logo-ofertante {
  flex: none; width: 48px; height: 48px; border-radius: 10px;
  display: flex; align-items: center; justify-content: center;
  font-weight: 700; font-size: 15px; color: #fff;
}

/* ---------- Detalhe ---------- */
.detalhe { display: flex; flex-direction: column; gap: 16px; min-width: 0; }
.bloco {
  background: var(--superficie); border: 1px solid var(--borda);
  border-radius: var(--raio-lg); padding: 20px;
}
.vaga-topo { display: flex; gap: 14px; align-items: flex-start; flex-wrap: wrap; }
.vaga-topo-texto { flex: 1; min-width: 220px; }
.vaga-topo h2 { font-size: 20px; letter-spacing: -.01em; margin-top: 6px; }
.vaga-topo .ofertante { font-size: 14px; color: var(--texto-2); }
.vaga-meta { display: flex; flex-wrap: wrap; gap: 8px 20px; margin-top: 12px; font-size: 13px; color: var(--texto-2); }
.vaga-meta span { display: flex; align-items: center; gap: 6px; }
.vaga-meta i { color: var(--texto-3); font-size: 16px; }
.btn-conversa { position: relative; }
.btn-conversa .ponto {
  position: absolute; top: -4px; right: -4px; width: 12px; height: 12px; border-radius: 50%;
  background: var(--perigo); border: 2px solid var(--superficie);
}

.avisos { display: flex; flex-direction: column; gap: 10px; }
.avisos:empty { display: none; }

/* ---------- Agenda semanal ---------- */
.agenda-topo { display: flex; justify-content: space-between; align-items: flex-start; gap: 12px; flex-wrap: wrap; }
.agenda-topo h3 { font-size: 17px; }
.prazo-escolha { font-size: 13px; color: var(--texto-2); display: flex; align-items: center; gap: 6px; margin-top: 4px; }
.prazo-escolha.urgente { color: var(--alerta-tx); font-weight: 600; }
.nav-semana { display: flex; align-items: center; gap: 4px; }
.nav-semana span { font-size: 14px; font-weight: 600; min-width: 180px; text-align: center; }

.legenda {
  display: flex; flex-wrap: wrap; align-items: center; gap: 8px 16px;
  margin: 16px 0 12px; font-size: 12px; color: var(--texto-2);
}
.legenda .amostra { display: inline-block; width: 14px; height: 14px; border-radius: 4px; vertical-align: -2px; margin-right: 5px; border: 1px solid; }
.amostra.livre { background: var(--superficie); border-color: var(--cor-primaria); }
.amostra.conflito { background: var(--alerta-bg); border-color: #e6b660; }
.amostra.ocupado { background: repeating-linear-gradient(45deg, #eef0f4, #eef0f4 3px, #f8f9fb 3px, #f8f9fb 6px); border-color: var(--borda); }
.amostra.selecionado { background: var(--cor-primaria); border-color: var(--cor-primaria); }
.legenda label { margin-left: auto; display: flex; align-items: center; gap: 6px; cursor: pointer; font-size: 13px; }
.legenda input { accent-color: var(--cor-primaria); width: 16px; height: 16px; }

.semana { display: grid; grid-template-columns: repeat(5, minmax(0, 1fr)); gap: 10px; }
.dia-col {
  background: var(--superficie-2); border: 1px solid var(--borda); border-radius: var(--raio);
  padding: 10px 8px; display: flex; flex-direction: column; gap: 6px; min-height: 150px;
}
.dia-col.passado { opacity: .55; }
.dia-cab { text-align: center; padding-bottom: 6px; border-bottom: 1px solid var(--borda); margin-bottom: 2px; }
.dia-cab strong { display: block; font-size: 13px; text-transform: capitalize; }
.dia-cab small { font-size: 12px; color: var(--texto-3); }
.dia-vazio { font-size: 12px; color: var(--texto-3); text-align: center; margin-top: 10px; }
.dia-slots { display: flex; flex-direction: column; gap: 6px; }

.slot {
  position: relative; width: 100%;
  padding: 8px 4px; border-radius: 8px; cursor: pointer;
  border: 1.5px solid var(--cor-primaria); background: var(--superficie);
  color: var(--cor-primaria); font-weight: 600; font-size: 14px;
  display: flex; flex-direction: column; align-items: center; line-height: 1.2;
  transition: background .12s, color .12s, transform .05s;
}
.slot small { font-size: 11px; font-weight: 500; opacity: .8; }
.slot:hover { background: var(--cor-primaria-clara); }
.slot:active { transform: scale(.97); }
.slot.conflito { border-color: #e6b660; background: var(--alerta-bg); color: var(--alerta-tx); }
.slot.ocupado {
  cursor: not-allowed; color: var(--texto-3); border-color: var(--borda);
  background: repeating-linear-gradient(45deg, #eef0f4, #eef0f4 4px, #f8f9fb 4px, #f8f9fb 8px);
  text-decoration: line-through;
}
.slot.selecionado { background: var(--cor-primaria); border-color: var(--cor-primaria); color: #fff; }
.slot .selo-novo {
  position: absolute; top: -8px; right: -6px;
  background: #16a36a; color: #fff; font-size: 10px; font-weight: 700;
  padding: 1px 6px; border-radius: 999px; text-decoration: none;
}
.slot.saiu { animation: saiu .6s ease; }
@keyframes saiu { 0%, 100% { transform: none; } 25% { transform: translateX(-4px); } 75% { transform: translateX(4px); } }

.barra-confirmar {
  margin-top: 16px; padding: 14px 16px; border-radius: var(--raio);
  background: var(--superficie-2); border: 1px dashed var(--borda-forte);
  display: flex; align-items: center; justify-content: space-between; gap: 12px; flex-wrap: wrap;
  font-size: 14px; color: var(--texto-2);
}
.barra-confirmar.pronta { background: var(--cor-primaria-clara); border: 1px solid #c4d3f7; color: var(--texto); }
.barra-confirmar strong { color: var(--cor-primaria); }

.alternativas { display: grid; grid-template-columns: 1fr auto; gap: 12px; align-items: center; }
.alternativas h3 { font-size: 15px; }
.alternativas p { font-size: 14px; color: var(--texto-2); margin-top: 2px; }
.alternativas .acoes { display: flex; gap: 8px; flex-wrap: wrap; justify-content: flex-end; }
.btn-texto.perigo { color: var(--perigo); }
.btn-texto.perigo:hover { background: #fdecec; }

/* ---------- Estados ---------- */
.estado { display: flex; flex-direction: column; align-items: center; text-align: center; gap: 10px; padding: 36px 20px; }
.estado-icone {
  width: 72px; height: 72px; border-radius: 50%;
  display: flex; align-items: center; justify-content: center; font-size: 34px;
}
.estado-icone.sucesso { background: var(--sucesso-bg); color: var(--sucesso-tx); }
.estado-icone.neutro { background: var(--cor-primaria-clara); color: var(--cor-primaria); }
.estado-icone.perigo { background: #fdecec; color: var(--perigo); }
.estado h3 { font-size: 21px; }
.estado p { color: var(--texto-2); max-width: 480px; }
.estado .acoes { display: flex; gap: 8px; flex-wrap: wrap; justify-content: center; margin-top: 6px; }

.resumo-entrevista {
  display: grid; grid-template-columns: repeat(auto-fit, minmax(170px, 1fr)); gap: 10px;
  width: 100%; max-width: 620px; margin: 8px 0; text-align: left;
}
.resumo-entrevista div { background: var(--superficie-2); border: 1px solid var(--borda); border-radius: var(--raio); padding: 10px 12px; }
.resumo-entrevista small { display: block; font-size: 12px; color: var(--texto-3); }
.resumo-entrevista strong { font-size: 14px; }

/* ---------- Conversa (gaveta lateral) ---------- */
.conversa {
  position: fixed; top: 0; right: 0; bottom: 0; z-index: 40;
  width: min(400px, 100vw); background: var(--superficie);
  border-left: 1px solid var(--borda); box-shadow: var(--sombra-forte);
  display: flex; flex-direction: column;
  transform: translateX(105%); transition: transform .25s ease;
}
.conversa.aberta { transform: none; }
.conversa-cab { display: flex; align-items: center; gap: 12px; padding: 14px 16px; border-bottom: 1px solid var(--borda); }
.conversa-cab .logo-ofertante { width: 38px; height: 38px; font-size: 12px; }
.conversa-cab strong { display: block; font-size: 15px; }
.conversa-cab small { color: var(--texto-3); font-size: 12px; }
.conversa-cab .btn { margin-left: auto; }
.mensagens { flex: 1; overflow-y: auto; padding: 16px; display: flex; flex-direction: column; gap: 10px; background: var(--superficie-2); }
.msg { max-width: 85%; padding: 10px 12px; border-radius: 14px; font-size: 14px; }
.msg small { display: block; font-size: 11px; opacity: .7; margin-top: 4px; }
.msg.ofertante { background: var(--superficie); border: 1px solid var(--borda); border-bottom-left-radius: 4px; align-self: flex-start; }
.msg.eu { background: var(--cor-primaria); color: #fff; border-bottom-right-radius: 4px; align-self: flex-end; }
.msg-vazia { margin: auto; text-align: center; color: var(--texto-3); font-size: 14px; }
.digitando { align-self: flex-start; font-size: 13px; color: var(--texto-3); font-style: italic; }
.respostas-rapidas { display: flex; flex-wrap: wrap; gap: 6px; padding: 10px 16px 0; }
.respostas-rapidas button {
  font-size: 12px; padding: 5px 10px; border-radius: 999px; cursor: pointer;
  border: 1px solid #c4d3f7; background: var(--cor-primaria-clara); color: var(--cor-primaria);
}
.conversa-form { display: flex; gap: 8px; padding: 12px 16px 16px; }
.conversa-form textarea {
  flex: 1; resize: none; height: 44px; padding: 10px 12px;
  border: 1px solid var(--borda-forte); border-radius: var(--raio); font: inherit;
}
.conversa-form .btn { height: 44px; }
.fundo-gaveta { position: fixed; inset: 0; z-index: 39; background: rgba(15, 22, 40, .3); }
.fundo-gaveta[hidden] { display: none; }

/* ---------- Painel de simulação (para a apresentação) ---------- */
.demo { position: fixed; left: 16px; bottom: 16px; z-index: 30; }
.demo-botao { box-shadow: var(--sombra-forte); background: var(--texto); color: #fff; border-color: var(--texto); }
.demo-botao:hover { background: #2c3446; border-color: #2c3446; }
.demo-painel {
  position: absolute; left: 0; bottom: 48px; width: 320px;
  background: var(--superficie); border: 1px solid var(--borda);
  border-radius: var(--raio-lg); box-shadow: var(--sombra-forte); padding: 14px;
}
.demo-painel[hidden] { display: none; }
.demo-painel p { font-size: 12px; color: var(--texto-3); margin-bottom: 10px; }
.demo-painel button.evento {
  display: flex; align-items: center; gap: 10px; width: 100%; text-align: left;
  padding: 9px 10px; border-radius: var(--raio); border: 0; background: transparent; cursor: pointer; font-size: 14px;
}
.demo-painel button.evento:hover { background: var(--superficie-2); }
.demo-painel button.evento i { font-size: 18px; color: var(--cor-primaria); }
.demo-painel button.evento small { display: block; font-size: 11px; color: var(--texto-3); }
.demo-painel hr { border: 0; border-top: 1px solid var(--borda); margin: 8px 0; }

/* ---------- Responsivo ---------- */
@media (max-width: 900px) {
  .agenda-layout { grid-template-columns: 1fr; padding: 12px 16px 96px; }
  .cabecalho-pagina { padding: 20px 16px 4px; }
  .lista-cand { position: static; }
  .semana { grid-template-columns: 1fr; }
  .dia-col { min-height: 0; flex-direction: row; align-items: flex-start; gap: 10px; }
  .dia-cab { border-bottom: 0; border-right: 1px solid var(--borda); padding: 0 10px 0 0; margin: 0; width: 64px; flex: none; text-align: left; }
  .dia-slots { flex-direction: row; flex-wrap: wrap; flex: 1; }
  .dia-slots .slot { width: auto; min-width: 72px; }
  .dia-vazio { margin: 6px 0 0; }
  .legenda label { margin-left: 0; }
  .alternativas { grid-template-columns: 1fr; }
  .alternativas .acoes { justify-content: flex-start; }
  .nav-semana span { min-width: 0; }
  .demo-painel { width: calc(100vw - 32px); }
}
