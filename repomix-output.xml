<file path="css/candidaturas.css">
/* ==========================================================
   Minhas candidaturas
   (reaproveita layout, .bloco, .item-cand e .demo de agenda.css)
   ========================================================== */

.metricas-cand { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 12px; margin-top: 18px; }
.metrica-c {
  background: var(--superficie); border: 1px solid var(--borda); border-radius: var(--raio-lg);
  padding: 12px 16px; display: flex; align-items: center; gap: 12px;
}
.metrica-c .ic {
  width: 38px; height: 38px; border-radius: 10px; flex: none;
  display: flex; align-items: center; justify-content: center; font-size: 20px;
  background: var(--cor-primaria-clara); color: var(--cor-primaria);
}
.metrica-c.alerta .ic { background: var(--alerta-bg); color: var(--alerta-tx); }
.metrica-c.sucesso .ic { background: var(--sucesso-bg); color: var(--sucesso-tx); }
.metrica-c strong { display: block; font-size: 22px; line-height: 1.1; }
.metrica-c small { font-size: 12px; color: var(--texto-3); }

/* ---------- Abas e lista ---------- */
.abas { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 3px; padding: 3px; background: var(--superficie-2); border: 1px solid var(--borda); border-radius: var(--raio); margin-bottom: 4px; }
.abas button { border: 0; background: transparent; padding: 8px 0; border-radius: 7px; font-weight: 600; font-size: 13px; color: var(--texto-2); cursor: pointer; }
.abas button[aria-selected="true"] { background: var(--superficie); color: var(--texto); box-shadow: 0 1px 3px rgba(20,30,60,.12); }
.abas span { color: var(--texto-3); font-weight: 500; }
.lista-itens { display: flex; flex-direction: column; gap: 8px; }
.lista-vazia { text-align: center; color: var(--texto-3); font-size: 14px; padding: 24px 8px; }

.mini-progresso { display: grid; grid-template-columns: repeat(6, 1fr); gap: 3px; margin: 2px 0 8px; }
.mini-progresso span { height: 4px; border-radius: 2px; background: var(--borda); }
.mini-progresso span.feito { background: var(--cor-primaria); }
.mini-progresso span.atual { background: var(--cor-primaria); opacity: .45; }
.mini-progresso.encerrada span.feito, .mini-progresso.encerrada span.atual { background: var(--texto-3); opacity: .5; }
.acao-linha { display: flex; align-items: flex-start; gap: 5px; font-size: 12px; font-weight: 500; line-height: 1.35; }
.acao-linha i { font-size: 14px; margin-top: 1px; }
.acao-linha.alerta { color: var(--alerta-tx); }
.acao-linha.info { color: var(--cor-primaria); }
.acao-linha.sucesso { color: var(--sucesso-tx); }
.acao-linha.neutro, .acao-linha.perigo { color: var(--texto-3); }

/* ---------- Etapas (stepper) ---------- */
.etapas { display: grid; grid-template-columns: repeat(6, minmax(0, 1fr)); margin-top: 4px; }
.etapa { position: relative; text-align: center; padding-top: 2px; }
.etapa::before {
  content: ""; position: absolute; top: 15px; left: -50%; right: 50%; height: 2px; background: var(--borda);
}
.etapa:first-child::before { display: none; }
.etapa.feita::before, .etapa.atual::before { background: var(--cor-primaria); }
.etapa-bola {
  position: relative; z-index: 1; margin: 0 auto 6px;
  width: 30px; height: 30px; border-radius: 50%;
  display: flex; align-items: center; justify-content: center; font-size: 15px; font-weight: 700;
  background: var(--superficie); border: 2px solid var(--borda-forte); color: var(--texto-3);
}
.etapa.feita .etapa-bola { background: var(--cor-primaria); border-color: var(--cor-primaria); color: #fff; }
.etapa.atual .etapa-bola { border-color: var(--cor-primaria); color: var(--cor-primaria); box-shadow: 0 0 0 4px var(--cor-primaria-clara); }
.etapa.parou .etapa-bola { border-color: var(--texto-3); background: var(--superficie-2); color: var(--texto-3); }
.etapa-nome { font-size: 12px; font-weight: 600; color: var(--texto-3); line-height: 1.25; }
.etapa.feita .etapa-nome, .etapa.atual .etapa-nome { color: var(--texto); }

/* ---------- Próxima ação ---------- */
.proxima {
  display: flex; gap: 14px; align-items: center; flex-wrap: wrap;
  padding: 16px 18px; border-radius: var(--raio-lg); border: 1px solid;
}
.proxima > i { font-size: 26px; flex: none; }
.proxima-texto { flex: 1; min-width: 220px; }
.proxima-texto strong { display: block; font-size: 16px; }
.proxima-texto p { font-size: 14px; margin-top: 2px; opacity: .9; }
.proxima.alerta { background: var(--alerta-bg); border-color: #f1d7a6; color: var(--alerta-tx); }
.proxima.info { background: #eef3fe; border-color: #c9d7fa; color: #1c3f8f; }
.proxima.sucesso { background: var(--sucesso-bg); border-color: #bfe3c6; color: var(--sucesso-tx); }
.proxima.neutro { background: var(--superficie-2); border-color: var(--borda); color: var(--texto-2); }
.proxima.perigo { background: #fdecec; border-color: #f5c4c4; color: #9b2222; }

.bloco h3.secao { font-size: 16px; margin-bottom: 4px; display: flex; align-items: center; gap: 8px; }
.bloco p.secao-sub { font-size: 13px; color: var(--texto-3); margin-bottom: 12px; }

/* ---------- Documentos ---------- */
.docs { display: flex; flex-direction: column; }
.doc { display: flex; align-items: center; gap: 12px; padding: 12px 0; border-top: 1px solid var(--borda); }
.doc:first-child { border-top: 0; }
.doc-ic {
  width: 38px; height: 38px; border-radius: 10px; flex: none;
  display: flex; align-items: center; justify-content: center; font-size: 20px;
}
.doc-ic.pendente { background: var(--superficie-2); color: var(--texto-3); border: 1px dashed var(--borda-forte); }
.doc-ic.enviado { background: #eef3fe; color: var(--cor-primaria); }
.doc-ic.aprovado { background: var(--sucesso-bg); color: var(--sucesso-tx); }
.doc-ic.recusado { background: #fdecec; color: var(--perigo); }
.doc-info { flex: 1; min-width: 0; }
.doc-nome { font-weight: 600; font-size: 14px; }
.doc-arquivo { font-size: 12px; color: var(--texto-3); overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.doc-obs { font-size: 13px; color: #9b2222; margin-top: 2px; }
.doc .etiqueta { flex: none; }
.doc-enviar input { position: absolute; width: 1px; height: 1px; opacity: 0; }
.doc-enviar { position: relative; }
.doc-enviar:focus-within .btn { outline: 2px solid var(--cor-primaria); outline-offset: 2px; }
.doc.carregando .doc-ic { animation: pulsar 1s ease infinite; }
@keyframes pulsar { 50% { opacity: .4; } }

/* ---------- Termo de compromisso ---------- */
.tce-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(170px, 1fr)); gap: 10px; margin-bottom: 16px; }
.tce-grid div { background: var(--superficie-2); border: 1px solid var(--borda); border-radius: var(--raio); padding: 10px 12px; }
.tce-grid small { display: block; font-size: 12px; color: var(--texto-3); }
.tce-grid strong { font-size: 14px; }
.assinaturas { display: flex; flex-direction: column; gap: 8px; margin-bottom: 14px; }
.assinatura { display: flex; align-items: center; gap: 12px; padding: 10px 12px; border: 1px solid var(--borda); border-radius: var(--raio); }
.assinatura > i { font-size: 22px; }
.assinatura .feita { color: var(--sucesso-tx); }
.assinatura .aguarda { color: var(--texto-3); }
.assinatura .vez { color: var(--alerta-tx); }
.assinatura div { flex: 1; }
.assinatura strong { display: block; font-size: 14px; }
.assinatura small { font-size: 12px; color: var(--texto-3); }

.instrucoes { background: var(--superficie-2); border: 1px solid var(--borda); border-radius: var(--raio); padding: 14px 16px; }
.instrucoes strong { display: flex; align-items: center; gap: 6px; font-size: 14px; margin-bottom: 6px; }
.instrucoes ul { margin: 0; padding-left: 20px; font-size: 13px; color: var(--texto-2); }
.instrucoes li + li { margin-top: 4px; }

/* ---------- Histórico ---------- */
.linha-tempo { list-style: none; margin: 0; padding: 0; }
.linha-tempo li { display: flex; gap: 12px; position: relative; padding-bottom: 14px; }
.linha-tempo li:not(:last-child)::before { content: ""; position: absolute; left: 15px; top: 32px; bottom: 0; width: 2px; background: var(--borda); }
.linha-tempo .lt-ic {
  width: 32px; height: 32px; border-radius: 50%; flex: none;
  background: var(--cor-primaria-clara); color: var(--cor-primaria);
  display: flex; align-items: center; justify-content: center; font-size: 16px;
}
.linha-tempo span { font-size: 14px; padding-top: 5px; }
.linha-tempo small { display: block; font-size: 12px; color: var(--texto-3); }

.feedback {
  font-family: Georgia, "Times New Roman", serif; font-style: italic; font-size: 15px; color: var(--texto-2);
  border-left: 3px solid var(--borda-forte); padding: 4px 0 4px 14px; margin-top: 10px;
}

.acoes-rodape { display: flex; gap: 8px; flex-wrap: wrap; justify-content: space-between; align-items: center; }

/* ---------- Modal do termo ---------- */
dialog.modal-termo { width: min(680px, calc(100vw - 32px)); max-height: calc(100vh - 48px); }
.documento {
  border: 1px solid var(--borda); border-radius: var(--raio); background: #fffdf8;
  padding: 22px 26px; max-height: 46vh; overflow-y: auto;
  font-family: Georgia, "Times New Roman", serif; font-size: 14px; line-height: 1.6; color: #2a2a2a;
}
.documento h4 { text-align: center; font-size: 15px; letter-spacing: .04em; margin: 0 0 4px; text-transform: uppercase; }
.documento .sub { text-align: center; font-size: 12px; color: #6b6b6b; margin-bottom: 16px; }
.documento p + p { margin-top: 10px; }
.documento .clausula { font-weight: 700; }
.documento .assin { display: grid; grid-template-columns: repeat(3, 1fr); gap: 12px; margin-top: 22px; font-family: var(--fonte); font-size: 12px; text-align: center; }
.documento .assin div { border-top: 1px solid #999; padding-top: 6px; }
.documento .assin .ok { color: var(--sucesso-tx); font-weight: 600; }
.concordo { display: flex; gap: 8px; align-items: flex-start; font-size: 14px; cursor: pointer; }
.concordo input { width: 18px; height: 18px; margin-top: 1px; accent-color: var(--cor-primaria); }

@media (max-width: 900px) {
  .metricas-cand { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  .etapa-nome { font-size: 10px; }
  .etapa-bola { width: 26px; height: 26px; font-size: 13px; }
  .etapa::before { top: 13px; }
  .documento .assin { grid-template-columns: 1fr; }
}

/* Três abas: nome em cima, quantidade embaixo */
.abas button { padding: 7px 4px; line-height: 1.25; }
.abas span { display: block; font-size: 11px; }
