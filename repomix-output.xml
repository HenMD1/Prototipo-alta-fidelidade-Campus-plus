/* ==========================================================
   Candidatos — quadro de triagem (ofertante)
   ========================================================== */

.cab-candidatos {
  max-width: 1280px; margin: 0 auto; padding: 28px 24px 8px;
  display: flex; align-items: flex-end; justify-content: space-between; gap: 16px; flex-wrap: wrap;
}
.cab-candidatos h1 { font-size: 26px; letter-spacing: -.02em; }
.cab-candidatos p { color: var(--texto-2); margin-top: 4px; }
.busca-cand { position: relative; flex: 0 1 320px; }
.busca-cand i { position: absolute; left: 12px; top: 50%; transform: translateY(-50%); color: var(--texto-3); }
.busca-cand input { width: 100%; height: 40px; padding: 0 12px 0 36px; border: 1px solid var(--borda-forte); border-radius: var(--raio); background: var(--superficie); }

.vagas-sel { max-width: 1280px; margin: 12px auto 0; padding: 0 24px; display: flex; gap: 8px; overflow-x: auto; }
.vagas-sel button {
  flex: none; display: flex; align-items: center; gap: 8px; padding: 8px 14px; cursor: pointer;
  border: 1px solid var(--borda-forte); border-radius: 999px; background: var(--superficie); font-size: 14px; font-weight: 500; color: var(--texto-2);
}
.vagas-sel button[aria-selected="true"] { border-color: var(--cor-primaria); background: var(--cor-primaria-clara); color: var(--cor-primaria); }
.vagas-sel .qtd { font-size: 12px; background: var(--superficie-2); border-radius: 999px; padding: 1px 8px; color: var(--texto-2); }
.vagas-sel button[aria-selected="true"] .qtd { background: #fff; color: var(--cor-primaria); }

/* ---------- Quadro ---------- */
.quadro {
  max-width: 1280px; margin: 0 auto; padding: 16px 24px 48px;
  display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 14px; align-items: start;
}
.coluna { background: #eef1f6; border-radius: var(--raio-lg); padding: 10px; display: flex; flex-direction: column; gap: 8px; min-height: 180px; }
.coluna-cab { display: flex; align-items: center; gap: 8px; padding: 4px 6px 6px; font-size: 14px; font-weight: 600; }
.coluna-cab .ponto { width: 9px; height: 9px; border-radius: 50%; }
.coluna-cab .n { margin-left: auto; font-size: 12px; color: var(--texto-3); background: var(--superficie); padding: 1px 8px; border-radius: 999px; }
.coluna-ajuda { font-size: 12px; color: var(--texto-3); padding: 0 6px 4px; margin-top: -4px; }
.coluna-vazia { font-size: 13px; color: var(--texto-3); text-align: center; padding: 22px 8px; border: 1px dashed var(--borda-forte); border-radius: var(--raio); }

.card-cand {
  display: flex; flex-direction: column; gap: 8px; width: 100%; text-align: left; cursor: pointer;
  background: var(--superficie); border: 1px solid var(--borda); border-radius: var(--raio); padding: 12px;
  transition: border-color .12s, box-shadow .12s;
}
.card-cand:hover { border-color: var(--borda-forte); box-shadow: var(--sombra); }
.card-cand.novo { box-shadow: 0 0 0 2px #16a36a; }
.card-topo { display: flex; gap: 10px; align-items: center; }
.av-c { width: 34px; height: 34px; border-radius: 50%; flex: none; display: flex; align-items: center; justify-content: center; color: #fff; font-weight: 700; font-size: 12px; }
.card-nome { font-weight: 600; font-size: 14px; line-height: 1.25; display: flex; align-items: center; gap: 6px; flex-wrap: wrap; }
.card-curso { font-size: 12px; color: var(--texto-3); }
.card-tags { display: flex; flex-wrap: wrap; gap: 4px; }
.card-tags .etiqueta { font-size: 11px; padding: 2px 7px; }
.etiqueta.neutra { background: var(--superficie-2); color: var(--texto-2); }
.etiqueta.perigo { background: #fdecec; color: #9b2222; }
.etiqueta.info { background: #eef3fe; color: var(--cor-primaria); }
.selo-demo { font-size: 10px; font-weight: 700; background: #e2f5ee; color: #0f6e56; padding: 1px 6px; border-radius: 999px; }

/* ---------- Ficha (gaveta) ---------- */
.fundo-ficha { position: fixed; inset: 0; z-index: 39; background: rgba(15,22,40,.35); }
.fundo-ficha[hidden] { display: none; }
.ficha {
  position: fixed; top: 0; right: 0; bottom: 0; z-index: 40; width: min(520px, 100vw);
  background: var(--superficie); box-shadow: var(--sombra-forte); display: flex; flex-direction: column;
  transform: translateX(105%); transition: transform .25s ease;
}
.ficha.aberta { transform: none; }
.ficha-cab { display: flex; gap: 12px; align-items: center; padding: 16px 18px; border-bottom: 1px solid var(--borda); }
.ficha-cab .av-c { width: 46px; height: 46px; font-size: 15px; }
.ficha-cab .info { flex: 1; min-width: 0; }
.ficha-cab strong { display: block; font-size: 17px; }
.ficha-cab small { color: var(--texto-3); font-size: 13px; }
.ficha-corpo { flex: 1; overflow-y: auto; padding: 16px 18px; display: flex; flex-direction: column; gap: 18px; }
.ficha-corpo h3 { font-size: 14px; margin-bottom: 8px; display: flex; align-items: center; gap: 6px; }
.ficha-rodape { padding: 12px 18px; border-top: 1px solid var(--borda); display: flex; gap: 8px; flex-wrap: wrap; align-items: center; }
.ficha-rodape .dir { margin-left: auto; display: flex; gap: 8px; }

.compat { display: flex; flex-direction: column; gap: 6px; }
.compat div { display: flex; gap: 8px; align-items: flex-start; font-size: 14px; }
.compat i { font-size: 18px; flex: none; }
.compat .ok i { color: var(--sucesso-tx); }
.compat .nao i { color: var(--alerta-tx); }
.compat small { display: block; color: var(--texto-3); font-size: 12px; }

.docs-c { display: flex; flex-direction: column; border: 1px solid var(--borda); border-radius: var(--raio); }
.doc-c { display: flex; align-items: center; gap: 10px; padding: 10px 12px; border-top: 1px solid var(--borda); }
.doc-c:first-child { border-top: 0; }
.doc-c > i { font-size: 22px; color: var(--texto-3); }
.doc-c .nome { flex: 1; min-width: 0; font-size: 14px; }
.doc-c .nome small { display: block; font-size: 12px; color: var(--texto-3); overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.doc-c .nome .obs { color: #9b2222; white-space: normal; }
.doc-c .acoes { display: flex; gap: 2px; }
.doc-c .acoes .btn { height: 32px; padding: 0 8px; font-size: 13px; }

.situacao-box { padding: 12px 14px; border-radius: var(--raio); font-size: 14px; border: 1px solid; display: flex; gap: 10px; }
.situacao-box i { font-size: 20px; flex: none; }
.situacao-box.info { background: #eef3fe; border-color: #c9d7fa; color: #1c3f8f; }
.situacao-box.sucesso { background: var(--sucesso-bg); border-color: #bfe3c6; color: var(--sucesso-tx); }
.situacao-box.neutro { background: var(--superficie-2); border-color: var(--borda); color: var(--texto-2); }
.situacao-box.alerta { background: var(--alerta-bg); border-color: #f1d7a6; color: var(--alerta-tx); }

/* ---------- Documento simulado ---------- */
dialog.modal-doc { width: min(640px, calc(100vw - 32px)); }
.folha {
  background: #fff; border: 1px solid var(--borda); border-radius: 6px; box-shadow: 0 2px 10px rgba(20,30,60,.08);
  padding: 26px 30px; max-height: 56vh; overflow-y: auto; font-family: Georgia, "Times New Roman", serif; color: #2a2a2a; font-size: 14px; line-height: 1.6;
}
.folha .marca-doc { font-family: var(--fonte); font-size: 11px; color: #9a9a9a; text-transform: uppercase; letter-spacing: .08em; text-align: center; margin-bottom: 10px; }
.folha h4 { text-align: center; font-size: 16px; margin: 0 0 14px; }
.folha table { width: 100%; border-collapse: collapse; font-family: var(--fonte); font-size: 13px; margin-top: 10px; }
.folha th, .folha td { border-bottom: 1px solid #e5e5e5; padding: 6px 4px; text-align: left; }
.folha th { font-weight: 600; color: #666; }
.folha .sec { font-family: var(--fonte); font-weight: 700; font-size: 13px; text-transform: uppercase; letter-spacing: .04em; color: #555; margin: 14px 0 4px; }

@media (max-width: 1000px) {
  .quadro { grid-template-columns: repeat(2, minmax(0, 1fr)); }
}
@media (max-width: 640px) {
  .quadro { grid-template-columns: minmax(0, 1fr); padding: 12px 16px 40px; }
  .cab-candidatos { padding: 20px 16px 4px; }
  .vagas-sel { padding: 0 16px; }
  .busca-cand { flex-basis: 100%; }
}
</file>

<file path="css/login.css">
/* ==========================================================
   Entrada: login, solicitação de acesso e recuperação de senha
   ========================================================== */

.pagina-login { background: var(--fundo); }
.login-layout { min-height: 100vh; display: grid; grid-template-columns: minmax(0, 1.1fr) minmax(0, 1fr); }

/* ---------- Apresentação ---------- */
.hero {
  background: #1d3f99;
  background-image: radial-gradient(circle at 85% 15%, rgba(255,255,255,.10) 0 120px, transparent 121px),
                    radial-gradient(circle at 85% 15%, rgba(255,255,255,.06) 0 220px, transparent 221px),
                    radial-gradient(circle at 85% 15%, rgba(255,255,255,.04) 0 330px, transparent 331px);
  color: #fff; padding: 40px 56px; display: flex; flex-direction: column; gap: 36px;
}
.marca-clara { color: #fff; }
.marca-clara .marca-sub { color: rgba(255,255,255,.7); }
.hero-texto { max-width: 560px; margin-top: auto; }
.hero h1 { font-size: 40px; line-height: 1.12; letter-spacing: -.03em; font-weight: 700; }
.hero-texto p { margin-top: 14px; font-size: 16px; color: rgba(255,255,255,.82); line-height: 1.6; }
.beneficios { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: 1fr 1fr; gap: 18px 24px; max-width: 640px; }
.beneficios li { display: flex; gap: 12px; font-size: 14px; color: rgba(255,255,255,.78); line-height: 1.45; }
.beneficios i {
  flex: none; width: 36px; height: 36px; border-radius: 10px; font-size: 19px;
  background: rgba(255,255,255,.12); display: flex; align-items: center; justify-content: center; color: #fff;
}
.beneficios b { display: block; color: #fff; font-weight: 600; margin-bottom: 2px; }
.numeros { display: flex; gap: 36px; margin-bottom: auto; flex-wrap: wrap; }
.numeros strong { display: block; font-size: 30px; letter-spacing: -.02em; }
.numeros span { font-size: 13px; color: rgba(255,255,255,.7); }

/* ---------- Cartão de acesso ---------- */
.acesso { display: flex; flex-direction: column; align-items: center; justify-content: center; padding: 40px 24px; gap: 16px; }
.cartao-acesso {
  width: 100%; max-width: 440px; background: var(--superficie);
  border: 1px solid var(--borda); border-radius: 18px; box-shadow: var(--sombra); padding: 30px 32px;
}
.cartao-acesso h2 { font-size: 24px; letter-spacing: -.02em; }
.cartao-acesso > p.sub { color: var(--texto-2); margin: 6px 0 20px; font-size: 14px; }
.voltar-acesso { display: inline-flex; align-items: center; gap: 4px; font-size: 14px; font-weight: 500; margin-bottom: 12px; background: none; border: 0; color: var(--cor-primaria); cursor: pointer; padding: 0; }

.perfil-abas { display: grid; grid-template-columns: 1fr 1fr; gap: 4px; padding: 4px; background: var(--superficie-2); border: 1px solid var(--borda); border-radius: 12px; margin-bottom: 20px; }
.perfil-abas button {
  display: flex; align-items: center; justify-content: center; gap: 6px;
  border: 0; background: transparent; border-radius: 9px; padding: 10px 0;
  font-weight: 600; font-size: 14px; color: var(--texto-2); cursor: pointer;
}
.perfil-abas button[aria-selected="true"] { background: var(--superficie); color: var(--cor-primaria); box-shadow: 0 1px 3px rgba(20,30,60,.12); }

.form-acesso { display: flex; flex-direction: column; gap: 14px; }
.campo-acesso label { display: flex; justify-content: space-between; font-size: 13px; font-weight: 600; margin-bottom: 6px; }
.campo-acesso label a, .campo-acesso label button { font-weight: 500; font-size: 13px; background: none; border: 0; color: var(--cor-primaria); cursor: pointer; padding: 0; }
.entrada { position: relative; }
.entrada > i { position: absolute; left: 12px; top: 50%; transform: translateY(-50%); color: var(--texto-3); font-size: 18px; pointer-events: none; }
.entrada input {
  width: 100%; height: 46px; padding: 0 44px 0 40px;
  border: 1px solid var(--borda-forte); border-radius: var(--raio); background: var(--superficie); font-size: 15px;
}
.entrada input:focus-visible { outline: 2px solid var(--cor-primaria); outline-offset: 1px; }
.entrada .ver-senha { position: absolute; right: 4px; top: 50%; transform: translateY(-50%); width: 38px; height: 38px; border: 0; background: transparent; color: var(--texto-3); cursor: pointer; border-radius: 8px; }
.entrada .ver-senha:hover { background: var(--superficie-2); color: var(--texto); }
.campo-acesso .ajuda { font-size: 12px; color: var(--texto-3); margin-top: 5px; }
.campo-acesso .erro-campo { font-size: 13px; color: var(--perigo); margin-top: 5px; display: flex; gap: 4px; align-items: flex-start; }
.campo-acesso.invalido input { border-color: var(--perigo); box-shadow: 0 0 0 3px #fdecec; }
.lembrar { display: flex; align-items: center; gap: 8px; font-size: 14px; color: var(--texto-2); cursor: pointer; }
.lembrar input { width: 16px; height: 16px; accent-color: var(--cor-primaria); }

.btn-grande { height: 48px; font-size: 15px; width: 100%; }
.girando { animation: girar .8s linear infinite; display: inline-block; }
@keyframes girar { to { transform: rotate(360deg); } }

.erro-geral { display: flex; gap: 8px; padding: 10px 12px; border-radius: var(--raio); background: #fdecec; border: 1px solid #f5c4c4; color: #9b2222; font-size: 14px; }
.erro-geral:empty { display: none; }

.divisor { display: flex; align-items: center; gap: 10px; color: var(--texto-3); font-size: 12px; margin: 4px 0; }
.divisor::before, .divisor::after { content: ""; flex: 1; height: 1px; background: var(--borda); }
.demo-acesso { width: 100%; }
.rodape-acesso { margin-top: 18px; padding-top: 16px; border-top: 1px solid var(--borda); font-size: 14px; color: var(--texto-2); text-align: center; }
.rodape-acesso button { background: none; border: 0; color: var(--cor-primaria); font-weight: 600; cursor: pointer; padding: 0; font-size: 14px; }

.info-acesso { display: flex; gap: 10px; padding: 12px 14px; border-radius: var(--raio); background: #eef3fe; border: 1px solid #c9d7fa; color: #1c3f8f; font-size: 13px; line-height: 1.45; }
.info-acesso i { font-size: 18px; flex: none; }

.sucesso-acesso { text-align: center; display: flex; flex-direction: column; align-items: center; gap: 10px; padding: 10px 0; }
.sucesso-acesso .ic { width: 68px; height: 68px; border-radius: 50%; background: var(--sucesso-bg); color: var(--sucesso-tx); display: flex; align-items: center; justify-content: center; font-size: 34px; }
.sucesso-acesso p { color: var(--texto-2); font-size: 14px; }
.passos-analise { text-align: left; width: 100%; margin: 6px 0 4px; padding: 0; list-style: none; display: flex; flex-direction: column; gap: 8px; font-size: 14px; }
.passos-analise li { display: flex; gap: 10px; align-items: flex-start; }
.passos-analise i { color: var(--cor-primaria); font-size: 18px; }

.aviso-prototipo { font-size: 12px; color: var(--texto-3); display: flex; align-items: center; gap: 6px; }

@media (max-width: 960px) {
  .login-layout { grid-template-columns: 1fr; }
  .hero { padding: 28px 20px; gap: 22px; }
  .hero h1 { font-size: 28px; }
  .beneficios { grid-template-columns: 1fr; gap: 12px; }
  .beneficios li:nth-child(n+3) { display: none; }
  .acesso { padding: 20px 16px 28px; justify-content: flex-start; order: -1; }
  .hero .marca { display: none; }
  .hero-texto { margin-top: 0; }
  .cartao-acesso { padding: 24px 20px; }
}

/* ---------- Contas de teste ("do zero") ---------- */
.bloco-teste {
  margin-top: 16px; padding: 14px 16px; border-radius: var(--raio);
  background: #f7f2fe; border: 1px dashed #cdb6f0; display: flex; flex-direction: column; gap: 6px; align-items: flex-start;
}
.bloco-teste strong { display: flex; align-items: center; gap: 6px; font-size: 14px; color: #5a2f99; }
.bloco-teste p { font-size: 13px; color: var(--texto-2); }
.bloco-teste .btn-texto { color: #6b3fa0; }
.atalhos-teste { display: flex; flex-wrap: wrap; align-items: center; gap: 6px; font-size: 12px; color: var(--texto-3); }
.atalhos-teste .btn { height: 32px; font-size: 13px; padding: 0 10px; }
.tipo-ofertante { display: flex; gap: 16px; flex-wrap: wrap; font-size: 14px; }
.tipo-ofertante label { display: flex; align-items: center; gap: 6px; cursor: pointer; }
.tipo-ofertante input { accent-color: var(--cor-primaria); width: 16px; height: 16px; }
.entrada select {
  width: 100%; height: 46px; padding: 0 12px 0 40px; font-size: 15px;
  border: 1px solid var(--borda-forte); border-radius: var(--raio); background: var(--superficie);
}
.campo-acesso.invalido select { border-color: var(--perigo); box-shadow: 0 0 0 3px #fdecec; }
.link-inline { background: none; border: 0; padding: 0; color: inherit; font-weight: 700; text-decoration: underline; cursor: pointer; font-size: inherit; }
</file>

<file path="css/mensagens.css">
/* ==========================================================
   Mensagens — caixa de entrada (estudante e ofertante)
   ========================================================== */

.caixa {
  max-width: 1280px; margin: 20px auto 24px; padding: 0 24px;
  display: grid; grid-template-columns: 340px minmax(0, 1fr);
  height: calc(100vh - 64px - 44px); min-height: 520px;
}
.caixa > * { background: var(--superficie); border: 1px solid var(--borda); }
.conversas { border-radius: var(--raio-lg) 0 0 var(--raio-lg); display: flex; flex-direction: column; min-height: 0; }
.janela { min-width: 0; border-left: 0; border-radius: 0 var(--raio-lg) var(--raio-lg) 0; display: flex; flex-direction: column; min-height: 0; }

/* ---------- Lista ---------- */
.conversas-topo { display: flex; align-items: center; justify-content: space-between; gap: 8px; padding: 16px 16px 10px; }
.conversas-topo h1 { font-size: 20px; letter-spacing: -.01em; }
.conversas-acoes { display: flex; gap: 4px; }
.busca-conv { position: relative; margin: 0 16px 10px; }
.busca-conv i { position: absolute; left: 11px; top: 50%; transform: translateY(-50%); color: var(--texto-3); }
.busca-conv input { width: 100%; height: 38px; padding: 0 10px 0 34px; border: 1px solid var(--borda-forte); border-radius: var(--raio); background: var(--superficie-2); }
.filtro-conv { display: flex; gap: 6px; padding: 0 16px 10px; border-bottom: 1px solid var(--borda); }
.filtro-conv button { border: 1px solid var(--borda-forte); background: var(--superficie); border-radius: 999px; padding: 4px 12px; font-size: 13px; font-weight: 500; color: var(--texto-2); cursor: pointer; }
.filtro-conv button[aria-selected="true"] { background: var(--cor-primaria-clara); border-color: var(--cor-primaria); color: var(--cor-primaria); }

.lista-conv { flex: 1; overflow-y: auto; }
.conv {
  display: flex; gap: 12px; width: 100%; text-align: left; align-items: flex-start;
  padding: 12px 16px; border: 0; border-bottom: 1px solid var(--borda); background: transparent; cursor: pointer;
}
.conv:hover { background: var(--superficie-2); }
.conv.ativa { background: var(--cor-primaria-clara); box-shadow: inset 3px 0 0 var(--cor-primaria); }
.av {
  width: 42px; height: 42px; border-radius: 50%; flex: none;
  display: flex; align-items: center; justify-content: center;
  font-weight: 700; font-size: 13px; color: #fff;
}
.av.quadrado { border-radius: 10px; }
.conv-corpo { flex: 1; min-width: 0; }
.conv-linha { display: flex; justify-content: space-between; gap: 8px; align-items: baseline; }
.conv-nome { font-weight: 600; font-size: 14px; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.conv-quando { font-size: 11px; color: var(--texto-3); flex: none; }
.conv-vaga { font-size: 12px; color: var(--texto-3); overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.conv-previa { font-size: 13px; color: var(--texto-2); overflow: hidden; text-overflow: ellipsis; white-space: nowrap; margin-top: 2px; }
.conv.nao-lida .conv-nome, .conv.nao-lida .conv-previa { color: var(--texto); font-weight: 600; }
.conv .bolinha { width: 9px; height: 9px; border-radius: 50%; background: var(--cor-primaria); flex: none; margin-top: 6px; }
.lista-vazia { padding: 32px 20px; text-align: center; color: var(--texto-3); font-size: 14px; }

/* ---------- Janela ---------- */
.janela-cab { display: flex; align-items: center; gap: 12px; padding: 12px 18px; border-bottom: 1px solid var(--borda); }
.janela-cab .info { flex: 1; min-width: 0; }
.janela-cab strong { display: block; font-size: 15px; }
.janela-cab small { font-size: 12px; color: var(--texto-3); }
.voltar-lista { display: none; }
.contexto {
  display: flex; align-items: center; gap: 10px; flex-wrap: wrap;
  padding: 8px 18px; background: var(--superficie-2); border-bottom: 1px solid var(--borda);
  font-size: 13px; color: var(--texto-2);
}
.contexto a { font-weight: 600; margin-left: auto; display: inline-flex; align-items: center; gap: 4px; }

.fio { flex: 1; overflow-y: auto; padding: 18px; display: flex; flex-direction: column; gap: 8px; background: #f7f8fb; }
.balao { max-width: min(75%, 520px); padding: 9px 13px; border-radius: 16px; font-size: 14px; line-height: 1.45; white-space: pre-wrap; word-wrap: break-word; }
.balao small { display: block; font-size: 11px; opacity: .65; margin-top: 3px; text-align: right; }
.balao.outro { align-self: flex-start; background: var(--superficie); border: 1px solid var(--borda); border-bottom-left-radius: 4px; }
.balao.eu { align-self: flex-end; background: var(--cor-primaria); color: #fff; border-bottom-right-radius: 4px; }
.balao .selo-grupo { display: inline-flex; align-items: center; gap: 4px; font-size: 11px; font-weight: 600; opacity: .8; margin-bottom: 3px; }
.anexo {
  display: flex; align-items: center; gap: 10px; padding: 8px 10px; margin: 2px 0;
  border-radius: 10px; background: rgba(255,255,255,.18); border: 1px solid rgba(255,255,255,.35);
}
.balao.outro .anexo { background: var(--superficie-2); border-color: var(--borda); }
.anexo i { font-size: 22px; }
.anexo strong { display: block; font-size: 13px; }
.anexo span { font-size: 11px; opacity: .75; }
.digitando { align-self: flex-start; font-size: 13px; color: var(--texto-3); font-style: italic; }

.compor { border-top: 1px solid var(--borda); padding: 10px 14px 14px; }
.rapidas { display: flex; gap: 6px; overflow-x: auto; padding-bottom: 8px; }
.rapidas button {
  flex: none; font-size: 12px; padding: 5px 10px; border-radius: 999px; cursor: pointer;
  border: 1px solid #c4d3f7; background: var(--cor-primaria-clara); color: var(--cor-primaria); white-space: nowrap;
}
.compor-linha { display: flex; gap: 8px; align-items: flex-end; }
.compor-linha textarea {
  flex: 1; resize: none; min-height: 44px; max-height: 140px; padding: 11px 12px;
  border: 1px solid var(--borda-forte); border-radius: var(--raio); font: inherit; line-height: 1.4;
}
.compor-linha .btn { height: 44px; }
.anexar { position: relative; }
.anexar input { position: absolute; width: 1px; height: 1px; opacity: 0; }
.anexar:focus-within .btn { outline: 2px solid var(--cor-primaria); outline-offset: 2px; }

.vazio-janela { margin: auto; text-align: center; color: var(--texto-3); padding: 24px; }
.vazio-janela i { font-size: 44px; display: block; margin-bottom: 8px; color: var(--borda-forte); }
.vazio-janela strong { display: block; color: var(--texto-2); font-size: 16px; margin-bottom: 4px; }

/* ---------- Modal de grupo ---------- */
.grupos { display: flex; flex-direction: column; gap: 6px; }
.grupos label {
  display: flex; align-items: center; gap: 10px; padding: 10px 12px; cursor: pointer;
  border: 1px solid var(--borda-forte); border-radius: var(--raio); font-size: 14px;
}
.grupos label:has(input:checked) { border-color: var(--cor-primaria); background: var(--cor-primaria-clara); }
.grupos input { accent-color: var(--cor-primaria); width: 16px; height: 16px; }
.grupos span { flex: 1; }
.grupos small { color: var(--texto-3); font-size: 12px; }
.grupos label.vazio { opacity: .55; }
select.controle { width: 100%; height: 42px; padding: 0 10px; border: 1px solid var(--borda-forte); border-radius: var(--raio); background: var(--superficie); }

/* ---------- Responsivo: lista OU conversa ---------- */
@media (max-width: 800px) {
  .caixa { grid-template-columns: minmax(0, 1fr); padding: 0; margin: 0; height: calc(100vh - 64px); }
  .caixa > * { border-radius: 0 !important; border-left: 0; border-right: 0; }
  .caixa.vendo-conversa .conversas { display: none; }
  .caixa:not(.vendo-conversa) .janela { display: none; }
  .voltar-lista { display: inline-flex; }
  .balao { max-width: 85%; }
}
</file>

<file path="css/style.css">
/* ==========================================================
   Radar de Oportunidades — estilos compartilhados
   ========================================================== */

:root {
  --cor-primaria: #2453c6;
  --cor-primaria-escura: #1a3f9c;
  --cor-primaria-clara: #e8eefc;

  --fundo: #f4f6fa;
  --superficie: #ffffff;
  --superficie-2: #f8f9fc;
  --borda: #e1e5ee;
  --borda-forte: #c9d0de;

  --texto: #1b2130;
  --texto-2: #4b5468;
  --texto-3: #7a8397;

  --estagio-bg: #e6effd;   --estagio-tx: #1c4fb8;
  --emprego-bg: #e2f5ee;   --emprego-tx: #0f6e56;
  --bolsa-bg:   #efeafd;   --bolsa-tx:   #5b3fbf;

  --sucesso-bg: #e3f4e6;   --sucesso-tx: #23702f;
  --alerta-bg:  #fdf1dc;   --alerta-tx:  #8a5a07;
  --perigo:     #d33b3b;

  --raio: 10px;
  --raio-lg: 14px;
  --sombra: 0 1px 2px rgba(20, 30, 60, .06), 0 4px 14px rgba(20, 30, 60, .06);
  --sombra-forte: 0 10px 40px rgba(20, 30, 60, .18);

  --fonte: "Inter", system-ui, -apple-system, "Segoe UI", Roboto, sans-serif;
}

* { box-sizing: border-box; }

html, body { margin: 0; }

body {
  font-family: var(--fonte);
  font-size: 15px;
  line-height: 1.5;
  color: var(--texto);
  background: var(--fundo);
  -webkit-font-smoothing: antialiased;
}

h1, h2, h3, h4 { margin: 0; line-height: 1.25; font-weight: 600; }
p { margin: 0; }
a { color: var(--cor-primaria); text-decoration: none; }
button, input, select { font: inherit; color: inherit; }
.sr-only {
  position: absolute; width: 1px; height: 1px; overflow: hidden;
  clip: rect(0 0 0 0); white-space: nowrap;
}

/* ---------- Botões ---------- */
.btn {
  display: inline-flex; align-items: center; justify-content: center; gap: 6px;
  height: 38px; padding: 0 16px;
  border-radius: var(--raio);
  border: 1px solid var(--borda-forte);
  background: var(--superficie);
  font-weight: 500; font-size: 14px;
  cursor: pointer;
  transition: background .15s, border-color .15s, transform .05s;
}
.btn:hover { background: var(--superficie-2); border-color: var(--texto-3); }
.btn:active { transform: scale(.98); }
.btn-primario { background: var(--cor-primaria); border-color: var(--cor-primaria); color: #fff; }
.btn-primario:hover { background: var(--cor-primaria-escura); border-color: var(--cor-primaria-escura); }
.btn-texto { border-color: transparent; background: transparent; color: var(--cor-primaria); padding: 0 8px; }
.btn-texto:hover { background: var(--cor-primaria-clara); border-color: transparent; }
.btn-icone { width: 38px; padding: 0; }
.btn:focus-visible, input:focus-visible, select:focus-visible, .chip:focus-within {
  outline: 2px solid var(--cor-primaria); outline-offset: 2px;
}

/* ---------- Barra superior ---------- */
.topo {
  position: sticky; top: 0; z-index: 20;
  background: var(--superficie);
  border-bottom: 1px solid var(--borda);
}
.topo-interno {
  max-width: 1280px; margin: 0 auto;
  height: 64px; padding: 0 24px;
  display: flex; align-items: center; gap: 28px;
}
.marca { display: flex; align-items: center; gap: 10px; color: var(--texto); }
.marca-logo { width: 34px; height: 34px; }
.marca-nome { font-weight: 700; font-size: 17px; letter-spacing: -.01em; }
.marca-sub { display: block; font-size: 11px; font-weight: 500; color: var(--texto-3); letter-spacing: .02em; }

.nav { display: flex; gap: 4px; }
.nav a {
  display: flex; align-items: center; gap: 6px;
  padding: 8px 12px; border-radius: var(--raio);
  color: var(--texto-2); font-weight: 500; font-size: 14px;
}
.nav a:hover { background: var(--superficie-2); color: var(--texto); }
.nav a.ativo { background: var(--cor-primaria-clara); color: var(--cor-primaria); }

.topo-acoes { margin-left: auto; display: flex; align-items: center; gap: 10px; }
.sino { position: relative; }
.sino .contador {
  position: absolute; top: 4px; right: 4px;
  min-width: 17px; height: 17px; padding: 0 4px;
  border-radius: 9px; background: var(--perigo); color: #fff;
  font-size: 10px; font-weight: 700; line-height: 17px; text-align: center;
}
.usuario { display: flex; align-items: center; gap: 10px; padding-left: 10px; border-left: 1px solid var(--borda); }
.avatar {
  width: 36px; height: 36px; border-radius: 50%;
  background: var(--cor-primaria-clara); color: var(--cor-primaria);
  display: flex; align-items: center; justify-content: center;
  font-weight: 600; font-size: 13px;
}
.usuario-nome { font-size: 13px; font-weight: 600; line-height: 1.2; }
.usuario-papel { font-size: 12px; color: var(--texto-3); }

/* ---------- Chips / etiquetas ---------- */
.etiqueta {
  display: inline-flex; align-items: center; gap: 4px;
  padding: 3px 9px; border-radius: 999px;
  font-size: 12px; font-weight: 600; white-space: nowrap;
}
.etiqueta.estagio { background: var(--estagio-bg); color: var(--estagio-tx); }
.etiqueta.emprego { background: var(--emprego-bg); color: var(--emprego-tx); }
.etiqueta.bolsa   { background: var(--bolsa-bg);   color: var(--bolsa-tx); }
.etiqueta.sucesso { background: var(--sucesso-bg); color: var(--sucesso-tx); }
.etiqueta.alerta  { background: var(--alerta-bg);  color: var(--alerta-tx); }

/* ---------- Toast ---------- */
.toast {
  position: fixed; left: 50%; bottom: 24px; z-index: 100;
  transform: translate(-50%, 20px); opacity: 0; pointer-events: none;
  background: var(--texto); color: #fff;
  padding: 12px 18px; border-radius: var(--raio);
  font-size: 14px; box-shadow: var(--sombra-forte);
  display: flex; align-items: center; gap: 8px;
  transition: opacity .2s, transform .2s;
}
.toast.visivel { opacity: 1; transform: translate(-50%, 0); }

@media (max-width: 900px) {
  .nav, .usuario-texto { display: none; }
  .topo-interno { padding: 0 16px; gap: 12px; }
}

/* ---------- Notificações (sino) ---------- */
.notif { position: relative; }
.sino .contador[hidden] { display: none; }
.sino.balanca i { animation: balanca .6s ease; }
@keyframes balanca {
  20% { transform: rotate(14deg); } 40% { transform: rotate(-12deg); }
  60% { transform: rotate(8deg); }  80% { transform: rotate(-4deg); }
}
.notif-painel {
  position: absolute; right: 0; top: 46px; width: 360px; max-width: calc(100vw - 24px);
  background: var(--superficie); border: 1px solid var(--borda);
  border-radius: var(--raio-lg); box-shadow: var(--sombra-forte); overflow: hidden;
}
.notif-painel[hidden] { display: none; }
.notif-cabecalho {
  display: flex; align-items: center; justify-content: space-between;
  padding: 10px 10px 10px 16px; border-bottom: 1px solid var(--borda);
}
.notif-lista { max-height: 380px; overflow-y: auto; }
.notif-item {
  display: flex; gap: 12px; padding: 12px 16px; color: var(--texto-2);
  border-bottom: 1px solid var(--borda); font-size: 13px;
}
.notif-item:hover { background: var(--superficie-2); }
.notif-item.nova { background: #f5f8ff; }
.notif-item.nova .notif-texto { color: var(--texto); }
.notif-icone {
  flex: none; width: 32px; height: 32px; border-radius: 50%;
  background: var(--cor-primaria-clara); color: var(--cor-primaria);
  display: flex; align-items: center; justify-content: center; font-size: 16px;
}
.notif-texto { display: block; }
.notif-quando { display: block; font-size: 12px; color: var(--texto-3); margin-top: 2px; }
.notif-vazia { padding: 24px 16px; text-align: center; color: var(--texto-3); font-size: 14px; }

/* ---------- Avisos (banners) ---------- */
.aviso {
  display: flex; gap: 12px; align-items: flex-start;
  padding: 12px 14px; border-radius: var(--raio); border: 1px solid;
  font-size: 14px;
}
.aviso > i { font-size: 20px; flex: none; margin-top: 1px; }
.aviso .aviso-corpo { flex: 1; }
.aviso .aviso-acoes { display: flex; gap: 8px; margin-top: 8px; flex-wrap: wrap; }
.aviso.info    { background: #eef3fe; border-color: #c9d7fa; color: #1c3f8f; }
.aviso.alerta  { background: var(--alerta-bg); border-color: #f1d7a6; color: var(--alerta-tx); }
.aviso.perigo  { background: #fdecec; border-color: #f5c4c4; color: #9b2222; }
.aviso.sucesso { background: var(--sucesso-bg); border-color: #bfe3c6; color: var(--sucesso-tx); }
.aviso .fechar-aviso { margin-left: auto; color: inherit; opacity: .7; }

/* ---------- Modal genérico ---------- */
dialog.modal {
  width: min(480px, calc(100vw - 32px)); padding: 0; border: 0;
  border-radius: var(--raio-lg); box-shadow: var(--sombra-forte); color: var(--texto);
}
dialog.modal::backdrop { background: rgba(15, 22, 40, .45); }
.modal-corpo { padding: 22px 24px; display: flex; flex-direction: column; gap: 14px; }
.modal-corpo h2 { font-size: 19px; }
.modal-corpo p { color: var(--texto-2); }
.modal-rodape { padding: 14px 24px; border-top: 1px solid var(--borda); display: flex; justify-content: flex-end; gap: 8px; }
.campo label { display: block; font-size: 13px; font-weight: 600; margin-bottom: 6px; }
.campo textarea {
  width: 100%; min-height: 90px; resize: vertical; padding: 10px 12px;
  border: 1px solid var(--borda-forte); border-radius: var(--raio); font: inherit;
}
.campo textarea:focus-visible { outline: 2px solid var(--cor-primaria); outline-offset: 1px; }
.campo .erro { color: var(--perigo); font-size: 13px; margin-top: 4px; }
.campo .erro:empty { display: none; }
.btn-perigo { background: var(--perigo); border-color: var(--perigo); color: #fff; }
.btn-perigo:hover { background: #b52f2f; border-color: #b52f2f; }
.btn[disabled] { opacity: .6; cursor: default; }

/* ---------- Troca de perfil (para a apresentação) ---------- */
.troca-perfil {
  display: flex; padding: 3px; gap: 2px;
  background: var(--superficie-2); border: 1px solid var(--borda); border-radius: 999px;
}
.troca-perfil a {
  display: flex; align-items: center; gap: 5px;
  padding: 5px 11px; border-radius: 999px;
  font-size: 12px; font-weight: 600; color: var(--texto-3);
}
.troca-perfil a:hover { color: var(--texto); }
.troca-perfil a.ativo { background: var(--superficie); color: var(--cor-primaria); box-shadow: 0 1px 3px rgba(20,30,60,.12); }
.avatar.ofertante { background: #fde8d7; color: #a4521a; }

@media (max-width: 900px) {
  .troca-perfil a span { display: none; }
  .troca-perfil a { padding: 6px 8px; }
}

.nav a, .usuario-texto { white-space: nowrap; }
@media (max-width: 1320px) {
  .troca-perfil a span { display: none; }
  .troca-perfil a { padding: 6px 8px; }
  .topo-interno { gap: 18px; }
  .usuario-papel { display: none; }
}
@media (max-width: 1100px) {
  .nav, .usuario-texto { display: none; }
}
.marca-sub, .selo-voce { white-space: nowrap; }
.toast.visivel { pointer-events: auto; }

/* ---------- Menu do usuário ---------- */
.usuario-menu { position: relative; }
button.usuario { border: 0; border-left: 1px solid var(--borda); background: transparent; cursor: pointer; text-align: left; padding: 4px 6px 4px 10px; border-radius: 0; }
button.usuario:hover .usuario-nome { color: var(--cor-primaria); }
.usuario-seta { color: var(--texto-3); font-size: 14px; }
.usuario-painel {
  position: absolute; right: 0; top: 50px; min-width: 200px; z-index: 30;
  background: var(--superficie); border: 1px solid var(--borda); border-radius: var(--raio-lg);
  box-shadow: var(--sombra-forte); padding: 6px;
}
.usuario-painel[hidden] { display: none; }
.usuario-painel a { display: flex; align-items: center; gap: 8px; padding: 9px 10px; border-radius: 8px; color: var(--texto); font-size: 14px; }
.usuario-painel a:hover { background: var(--superficie-2); }
.usuario-painel a[data-sair] { color: var(--perigo); }
@media (max-width: 1100px) { .usuario-seta { display: none; } }

/* ---------- Ajustes de largura do cabeçalho (revisão) ---------- */
.topo-interno { min-width: 0; }
@media (max-width: 1440px) {
  .troca-perfil a span { display: none; }
  .troca-perfil a { padding: 6px 8px; }
  .usuario-papel { display: none; }
  .topo-interno { gap: 18px; }
  .nav a { padding: 8px 10px; }
}
@media (max-width: 480px) {
  .marca-sub { display: none; }
  .topo-interno { gap: 10px; padding: 0 12px; }
  .topo-acoes { gap: 6px; }
  button.usuario { padding-left: 6px; }
}

/* ---------- Selo do ambiente "Teste do zero" ---------- */
.selo-ambiente {
  display: inline-flex; align-items: center; gap: 5px; flex: none;
  padding: 4px 10px; border-radius: 999px; font-size: 12px; font-weight: 600;
  background: #f3ecfd; color: #6b3fa0; border: 1px solid #dccbf5;
}
@media (max-width: 1440px) { .selo-ambiente span { display: none; } .selo-ambiente { padding: 5px 7px; } }
</file>

<file path="css/vagas.css">
/* ==========================================================
   Minhas vagas e cadastro de vaga (ofertante)
   (reaproveita .cartao, .chip e .segmentado de mural.css)
   ========================================================== */

.pagina { max-width: 1280px; margin: 0 auto; padding: 0 24px 120px; }
.voltar { display: inline-flex; align-items: center; gap: 4px; font-size: 14px; font-weight: 500; margin-bottom: 6px; }

/* ---------- Lista de vagas ---------- */
.resumo-vagas { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 12px; margin: 8px 0 18px; }
.resumo-vagas div { background: var(--superficie); border: 1px solid var(--borda); border-radius: var(--raio-lg); padding: 12px 16px; }
.resumo-vagas small { display: block; font-size: 12px; color: var(--texto-3); }
.resumo-vagas strong { font-size: 22px; }

.tabela-vagas { background: var(--superficie); border: 1px solid var(--borda); border-radius: var(--raio-lg); overflow: hidden; }
.linha-vaga {
  display: grid; grid-template-columns: minmax(0, 2.4fr) 1fr 1fr 1fr auto; gap: 16px; align-items: center;
  padding: 14px 18px; border-top: 1px solid var(--borda);
}
.linha-vaga.cab { border-top: 0; background: var(--superficie-2); font-size: 12px; font-weight: 600; color: var(--texto-3); padding: 10px 18px; }
.linha-vaga.destaque { animation: destacar 2.4s ease; }
@keyframes destacar { 0%, 40% { background: #eaf6ef; } 100% { background: transparent; } }
.lv-titulo strong { display: block; font-size: 15px; }
.lv-titulo span { font-size: 12px; color: var(--texto-3); }
.lv-num { font-size: 14px; }
.lv-num small { display: block; font-size: 12px; color: var(--texto-3); }
.lv-acoes { display: flex; gap: 4px; justify-content: flex-end; }
.lv-acoes .btn { height: 34px; padding: 0 10px; font-size: 13px; }
.motivo-enc { font-size: 12px; color: var(--texto-3); margin-top: 4px; }

/* ---------- Formulário ---------- */
.form-layout { display: grid; grid-template-columns: minmax(0, 1fr) 360px; gap: 24px; align-items: start; }
.passos { display: grid; grid-template-columns: repeat(4, 1fr); gap: 8px; margin-bottom: 16px; }
.passo {
  display: flex; align-items: center; gap: 10px; text-align: left;
  padding: 10px 12px; border-radius: var(--raio); border: 1px solid var(--borda);
  background: var(--superficie); cursor: pointer; font-size: 13px; font-weight: 600; color: var(--texto-3);
}
.passo .num {
  width: 26px; height: 26px; border-radius: 50%; flex: none;
  display: flex; align-items: center; justify-content: center; font-size: 13px;
  border: 2px solid var(--borda-forte);
}
.passo.atual { border-color: var(--cor-primaria); color: var(--texto); box-shadow: 0 0 0 3px var(--cor-primaria-clara); }
.passo.atual .num { border-color: var(--cor-primaria); color: var(--cor-primaria); }
.passo.feito { color: var(--texto); }
.passo.feito .num { background: var(--cor-primaria); border-color: var(--cor-primaria); color: #fff; }
.passo.com-erro .num { background: var(--perigo); border-color: var(--perigo); color: #fff; }

.cartao-form { background: var(--superficie); border: 1px solid var(--borda); border-radius: var(--raio-lg); padding: 22px 24px; }
.cartao-form h2 { font-size: 18px; margin-bottom: 4px; }
.cartao-form > p { color: var(--texto-2); font-size: 14px; margin-bottom: 18px; }
.grade-campos { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 16px 18px; }
.cheio { grid-column: 1 / -1; }

.campo-form > label, .campo-form > .rotulo { display: block; font-size: 13px; font-weight: 600; margin-bottom: 6px; }
.campo-form .opcional { font-weight: 400; color: var(--texto-3); }
.controle, .campo-form input[type="text"], .campo-form input[type="number"], .campo-form input[type="date"], .campo-form select, .campo-form textarea, .modal select.controle {
  width: 100%; height: 42px; padding: 0 12px;
  border: 1px solid var(--borda-forte); border-radius: var(--raio); background: var(--superficie); font: inherit;
}
.campo-form textarea { height: auto; min-height: 110px; padding: 10px 12px; resize: vertical; line-height: 1.5; }
.campo-form .ajuda { font-size: 12px; color: var(--texto-3); margin-top: 5px; }
.campo-form .contador { float: right; }
.campo-form .erro-campo { font-size: 13px; color: var(--perigo); margin-top: 5px; display: flex; gap: 4px; align-items: flex-start; }
.campo-form.invalido input, .campo-form.invalido select, .campo-form.invalido textarea, .campo-form.invalido .chips, .campo-form.invalido .itens-lista { border-color: var(--perigo); box-shadow: 0 0 0 3px #fdecec; }
.campo-form.invalido .chips { border: 1px solid; border-radius: var(--raio); padding: 6px; }
.prefixo { position: relative; }
.prefixo > span { position: absolute; left: 12px; top: 50%; transform: translateY(-50%); color: var(--texto-3); font-size: 14px; }
.prefixo input { padding-left: 40px !important; }
.sufixo { position: relative; }
.sufixo > span { position: absolute; right: 12px; top: 50%; transform: translateY(-50%); color: var(--texto-3); font-size: 14px; pointer-events: none; }

.tipos { display: grid; grid-template-columns: repeat(3, 1fr); gap: 10px; }
.tipo-op { position: relative; }
.tipo-op input { position: absolute; opacity: 0; inset: 0; margin: 0; cursor: pointer; }
.tipo-op div {
  height: 100%; padding: 12px; border: 1px solid var(--borda-forte); border-radius: var(--raio);
  display: flex; flex-direction: column; gap: 2px; font-size: 12px; color: var(--texto-3);
}
.tipo-op strong { font-size: 14px; color: var(--texto); display: flex; align-items: center; gap: 6px; }
.tipo-op input:checked + div { border-color: var(--cor-primaria); background: var(--cor-primaria-clara); box-shadow: 0 0 0 1px var(--cor-primaria); }
.tipo-op input:focus-visible + div { outline: 2px solid var(--cor-primaria); outline-offset: 2px; }
.tipo-op input:disabled + div { opacity: .55; cursor: not-allowed; background: var(--superficie-2); }

.check-linha { display: flex; align-items: center; gap: 8px; font-size: 14px; cursor: pointer; }
.check-linha input { width: 17px; height: 17px; accent-color: var(--cor-primaria); }

.itens-lista { display: flex; flex-direction: column; gap: 6px; margin-bottom: 8px; }
.itens-lista:empty { display: none; }
.item-lista { display: flex; align-items: center; gap: 8px; padding: 7px 8px 7px 12px; background: var(--superficie-2); border: 1px solid var(--borda); border-radius: var(--raio); font-size: 14px; }
.item-lista span { flex: 1; }
.item-lista button { width: 28px; height: 28px; border: 0; background: transparent; border-radius: 6px; cursor: pointer; color: var(--texto-3); }
.item-lista button:hover { background: #fdecec; color: var(--perigo); }
.add-item { display: flex; gap: 8px; }
.add-item input { flex: 1; }

.dica-lei { display: flex; gap: 10px; padding: 10px 12px; border-radius: var(--raio); background: #eef3fe; border: 1px solid #c9d7fa; color: #1c3f8f; font-size: 13px; }
.dica-lei i { font-size: 18px; flex: none; }

.navegacao-form { display: flex; justify-content: space-between; align-items: center; gap: 10px; margin-top: 22px; padding-top: 18px; border-top: 1px solid var(--borda); flex-wrap: wrap; }
.navegacao-form .dir { display: flex; gap: 8px; margin-left: auto; }

.revisao { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 10px; }
.revisao div { background: var(--superficie-2); border: 1px solid var(--borda); border-radius: var(--raio); padding: 10px 12px; }
.revisao small { display: block; font-size: 12px; color: var(--texto-3); }
.revisao strong { font-size: 14px; }
.revisao .cheio { grid-column: 1 / -1; }

/* ---------- Prévia ---------- */
.previa { position: sticky; top: 80px; display: flex; flex-direction: column; gap: 12px; }
.previa > h3 { font-size: 13px; text-transform: uppercase; letter-spacing: .06em; color: var(--texto-3); }
.previa .cartao { animation: none; }
.previa .cartao:hover { transform: none; }
.alcance { background: var(--superficie); border: 1px solid var(--borda); border-radius: var(--raio-lg); padding: 14px 16px; font-size: 13px; }
.alcance strong { display: flex; align-items: center; gap: 6px; font-size: 14px; margin-bottom: 8px; }
.alcance ul { margin: 0; padding-left: 18px; color: var(--texto-2); }
.alcance li + li { margin-top: 3px; }

.lista-mudancas { margin: 0; padding-left: 20px; color: var(--texto-2); font-size: 14px; }
.lista-mudancas li + li { margin-top: 4px; }
.campo .erro:empty { display: none; }

@media (max-width: 1000px) {
  .pagina { padding: 0 16px 120px; }
  .form-layout { grid-template-columns: 1fr; }
  .previa { position: static; }
  .grade-campos, .revisao { grid-template-columns: 1fr; }
  .tipos { grid-template-columns: 1fr; }
  .passos { grid-template-columns: repeat(4, auto); overflow-x: auto; }
  .passo span.txt { display: none; }
  .resumo-vagas { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  .linha-vaga { grid-template-columns: 1fr auto; }
  .linha-vaga.cab { display: none; }
  .linha-vaga .lv-num { display: none; }
  .linha-vaga .lv-acoes { grid-column: 1 / -1; justify-content: flex-start; flex-wrap: wrap; }
}
</file>

<file path="js/agenda-dados.js">
/* ==========================================================
   Dados fictícios — Agendar entrevista
   Classes do diagrama: Candidatura, AgendaEntrevista,
   HorarioEntrevista, Entrevista e Mensagem.

   Os horários usam "d" = dias a partir da próxima segunda-feira
   (0 = segunda desta próxima semana, 7 = segunda da seguinte),
   para que o protótipo funcione em qualquer data.
   ========================================================== */

// Grade de aulas padrão (a mesma que o perfil importa do portal do aluno).
// Usada para avisar conflitos enquanto o estudante não salvou o perfil;
// depois disso, vale a grade cadastrada em perfil.html.
const GRADE_AULAS = [
  { dia: 1, ini: "13:30", fim: "15:10", disciplina: "INF01124 — Estruturas de Dados" },
  { dia: 2, ini: "10:30", fim: "12:10", disciplina: "INF01127 — Engenharia de Software" },
  { dia: 3, ini: "13:30", fim: "15:10", disciplina: "INF01124 — Estruturas de Dados" },
  { dia: 4, ini: "10:30", fim: "12:10", disciplina: "INF01127 — Engenharia de Software" },
];

const CANDIDATURAS_INICIAIS = [
  {
