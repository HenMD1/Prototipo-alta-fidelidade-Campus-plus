</head>
<body class="pagina-login">

  <main class="login-layout">
    <!-- Apresentação -->
    <section class="hero" aria-labelledby="hero-titulo">
      <a class="marca marca-clara" href="index.html">
        <svg class="marca-logo" viewBox="0 0 40 40" aria-hidden="true">
