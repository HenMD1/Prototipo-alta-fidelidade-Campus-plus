}

function paraForm(v) {
  return {
    ...vagaVazia(), ...JSON.parse(JSON.stringify(v)),
    turno: v.turno || "Flexível",
    cargaSemanaProvas: v.cargaSemanaProvas ?? Math.floor(v.cargaHoraria / 2),
    permiteNegociacaoHorario: v.permiteNegociacaoHorario ?? true,
